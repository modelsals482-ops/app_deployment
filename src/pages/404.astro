---
import Base from "../layouts/Base.astro";
---
<Base
  title="404 — stránka nenalezena | ALSflow"
  description="Tahle stránka neexistuje. Tady je cesta zpátky — a když máte chvíli, malá hra."
  canonical="https://alsflow.cz/404"
  robots="noindex, follow"
>
  <section class="hero-plain">
    <div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i></div>
    <div class="wrap">
      <span class="eyebrow-label">Chyba 404</span>
      <h1 class="h-hero fade-head">Tahle stránka <span class="grad">neexistuje</span></h1>
      <p class="lead">Nejspíš je to překlep v adrese, nebo jsme stránku přesunuli. Tady je, kam jste
        nejspíš mířili:</p>
      <div class="btn-row">
        <a class="btn btn-grad btn-magnet" href="/">Úvodní stránka</a>
        <a class="btn btn-quiet" href="/kontakt">Napsat nám</a>
      </div>
      <ul class="fof-links">
        <li><a href="/tvorba-webu">Tvorba webu</a></li>
        <li><a href="/vyvoj-softwaru">Vývoj softwaru</a></li>
        <li><a href="/ai-asistenti">AI asistenti</a></li>
        <li><a href="/cenik">Ceník</a></li>
        <li><a href="/o-nas">O nás</a></li>
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec">Nechcete si zahr&aacute;t <span class="grad">hada</span>?</h2>
        <p class="lead">Ovl&aacute;d&aacute;n&iacute; &scaron;ipkami nebo WASD, na telefonu tahem prstu.</p>
      </div>

      <div class="fof-game">
        <div class="fof-bar">
          <span>Skóre <b data-score>0</b></span>
          <span>Nejlepší <b data-best>0</b></span>
          <button class="btn btn-quiet" type="button" data-play>Hrát</button>
        </div>
        <canvas data-snake width="480" height="480" role="img"
                aria-label="Jednoduchá hra had. Není nutná k ničemu na webu."></canvas>
        <p class="fof-msg" data-msg hidden></p>
      </div>
    </div>
  </section>

  <Fragment slot="tail">
    <style>
      .fof-links { list-style:none; display:flex; flex-wrap:wrap; gap:0.35rem 1.25rem;
        padding:0; margin:2rem 0 0; font-size:0.95rem; }
      .fof-links a { color:var(--t2,#9aa); text-decoration:none; border-bottom:1px solid transparent; }
      .fof-links a:hover, .fof-links a:focus-visible { color:#fff; border-bottom-color:currentColor; }

      .fof-game { max-width:520px; margin:0 auto; }
      .fof-bar { display:flex; align-items:center; gap:1.25rem; margin-bottom:0.85rem;
        font-size:0.9rem; letter-spacing:0.04em; text-transform:uppercase; }
      .fof-bar b { font-variant-numeric:tabular-nums; }
      .fof-bar .btn { margin-left:auto; }
      .fof-game canvas { width:100%; height:auto; aspect-ratio:1; display:block; border-radius:14px;
        background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.09); touch-action:none; }
      .fof-msg { margin-top:0.85rem; min-height:1.4em; }
      @media (prefers-reduced-motion: reduce) { .fof-game canvas { outline:none; } }
    </style>

    <script is:inline>
      /* Malý had. Bez knihoven, bez ukládání čehokoli mimo tenhle prohlížeč.
         Je to doplněk 404 stránky, ne její obsah: nadpis, vysvětlení a odkazy
         stojí nad ním a fungují i s vypnutým JavaScriptem. */
      (function () {
        var cv = document.querySelector("[data-snake]");
        if (!cv || !cv.getContext) return;

        var ctx = cv.getContext("2d");
        var N = 16;                       /* políček na stranu */
        var S = cv.width / N;
        var scoreEl = document.querySelector("[data-score]");
        var bestEl = document.querySelector("[data-best]");
        var msgEl = document.querySelector("[data-msg]");
        var playBtn = document.querySelector("[data-play]");

        var best = 0;
        try { best = parseInt(localStorage.getItem("als-snake") || "0", 10) || 0; } catch (e) {}
        bestEl.textContent = best;

        var snake, dir, next, food, timer, score, alive = false;

        function place() {
          do {
            food = { x: (Math.random() * N) | 0, y: (Math.random() * N) | 0 };
          } while (snake.some(function (s) { return s.x === food.x && s.y === food.y; }));
        }

        function reset() {
          snake = [{ x: 8, y: 8 }, { x: 7, y: 8 }, { x: 6, y: 8 }];
          dir = { x: 1, y: 0 };
          next = dir;
          score = 0;
          scoreEl.textContent = "0";
          place();
        }

        function grad() {
          var g = ctx.createLinearGradient(0, 0, cv.width, cv.height);
          g.addColorStop(0, "#22d3ee");
          g.addColorStop(0.5, "#3b82f6");
          g.addColorStop(1, "#a855f7");
          return g;
        }

        function draw() {
          ctx.clearRect(0, 0, cv.width, cv.height);

          ctx.fillStyle = "rgba(255,255,255,0.55)";
          ctx.fillRect(food.x * S + S * 0.3, food.y * S + S * 0.3, S * 0.4, S * 0.4);

          ctx.fillStyle = grad();
          snake.forEach(function (s, i) {
            var pad = i === 0 ? 1 : 2.5;
            ctx.fillRect(s.x * S + pad, s.y * S + pad, S - pad * 2, S - pad * 2);
          });
        }

        function stop(text) {
          alive = false;
          clearInterval(timer);
          msgEl.hidden = false;
          msgEl.textContent = text;
          playBtn.textContent = "Hrát znovu";
          playBtn.focus();
        }

        function step() {
          dir = next;
          var head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

          if (head.x < 0 || head.y < 0 || head.x >= N || head.y >= N ||
              snake.some(function (s) { return s.x === head.x && s.y === head.y; })) {
            if (score > best) {
              best = score;
              bestEl.textContent = best;
              try { localStorage.setItem("als-snake", String(best)); } catch (e) {}
            }
            stop("Konec. Skóre " + score + ". Zpátky na " + "„úvodní stránku“" + " vede tlačítko nahoře.");
            return;
          }

          snake.unshift(head);
          if (head.x === food.x && head.y === food.y) {
            score++;
            scoreEl.textContent = score;
            place();
          } else {
            snake.pop();
          }
          draw();
        }

        function play() {
          reset();
          draw();
          msgEl.hidden = true;
          playBtn.textContent = "Restart";
          alive = true;
          clearInterval(timer);
          timer = setInterval(step, 110);
        }

        function turn(x, y) {
          /* couvnout do sebe nejde */
          if (dir.x === -x && dir.y === -y) return;
          next = { x: x, y: y };
        }

        var KEYS = {
          ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0],
          w: [0, -1], s: [0, 1], a: [-1, 0], d: [1, 0]
        };

        document.addEventListener("keydown", function (e) {
          var k = KEYS[e.key] || KEYS[(e.key || "").toLowerCase()];
          if (!k || !alive) return;
          e.preventDefault();          /* šipky jinak rolují stránkou */
          turn(k[0], k[1]);
        });

        var t0 = null;
        cv.addEventListener("pointerdown", function (e) { t0 = { x: e.clientX, y: e.clientY }; });
        cv.addEventListener("pointerup", function (e) {
          if (!t0 || !alive) return;
          var dx = e.clientX - t0.x, dy = e.clientY - t0.y;
          if (Math.abs(dx) < 12 && Math.abs(dy) < 12) return;
          if (Math.abs(dx) > Math.abs(dy)) turn(dx > 0 ? 1 : -1, 0);
          else turn(0, dy > 0 ? 1 : -1);
          t0 = null;
        });

        playBtn.addEventListener("click", play);

        /* Nespouští se samo: pohyb na stránce, o který nikdo nepožádal, je
           přesně to, co obtěžuje. Nakreslí se jen výchozí obrázek. */
        reset();
        draw();
      })();
    </script>
  </Fragment>
</Base>
