---
import Base from '../layouts/Base.astro';
---

<Base title={"404 — Stránka nenalezena | ALSflow"}
  description={"Stránka nenalezena — ALSflow"}
  robots={"noindex, follow"}>

<!-- Nav -->
<nav class="nav">
  <a href="/" class="logo-lockup" aria-label="ALSflow — domovská stránka">
    <svg width="30" height="30" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="nav-lm" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#4e8ff7"/>
          <stop offset="100%" stop-color="#1d55d4"/>
        </linearGradient>
      </defs>
      <rect width="40" height="40" rx="10" fill="url(#nav-lm)"/>
      <path d="M11 29.5L20 10.5L29 29.5" stroke="white" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M14.8 23 Q20 21.2 25.2 23" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <circle cx="28.4" cy="23" r="2.2" fill="white"/>
    </svg>
    <div class="logo-wordmark"><span class="als">ALS</span><span class="flow">flow</span></div>
  </a>
</nav>

<!-- Main -->
<div class="page">

  <!-- Faint decorative background mark -->
  <svg class="bg-mark" width="640" height="640" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="bg-lm" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4e8ff7"/>
        <stop offset="100%" stop-color="#1d55d4"/>
      </linearGradient>
    </defs>
    <rect width="40" height="40" rx="10" fill="url(#bg-lm)"/>
    <path d="M11 29.5L20 10.5L29 29.5" stroke="white" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M14.8 23 Q20 21.2 25.2 23" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    <circle cx="28.4" cy="23" r="2.2" fill="white"/>
  </svg>

  <div class="badge" role="status">
    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
      <circle cx="5.5" cy="5.5" r="4.5" stroke="#60a5fa" stroke-width="1.4"/>
      <path d="M5.5 3.5v2.25L6.75 7" stroke="#60a5fa" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    Chyba 404
  </div>

  <div class="error-code" aria-label="404">404</div>

  <h1 class="error-title">Stránka nenalezena</h1>
  <p class="error-desc">
    Stránka, kterou hledáte, neexistuje nebo byla přesunuta.<br>
    Vraťte se na hlavní stránku a zkuste to znovu.
  </p>

  <div class="btn-row">
    <a href="/" class="btn-home">
      <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
        <path d="M7.5 1.5L1.5 7v6.5h4V10h4v3.5h4V7L7.5 1.5Z" stroke="white" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
      </svg>
      Zpět na hlavní stránku
    </a>
    <a href="mailto:info@alsflow.cz" class="btn-secondary">
      <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
        <rect x="1.5" y="3.5" width="12" height="8" rx="1.5" stroke="#8a8a9e" stroke-width="1.4" fill="none"/>
        <path d="M1.5 5l6 4 6-4" stroke="#8a8a9e" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      Kontaktovat nás
    </a>
  </div>

  <div class="divider" aria-hidden="true"></div>
  <p class="footer-note">alsflow.cz &nbsp;&middot;&nbsp; AI automatizace pro české podnikatele</p>

</div>

</Base>

<style is:global>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:var(--font);background:var(--bg);color:var(--t1);-webkit-font-smoothing:antialiased;}
/* ── NAV ── */
  .nav{
    position:fixed;top:0;left:0;right:0;
    padding:1.25rem 2.5rem;
    display:flex;align-items:center;
    border-bottom:1px solid var(--border);
    background:rgba(9,9,15,0.85);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    z-index:10;
  }
.logo-lockup{display:flex;align-items:center;gap:10px;text-decoration:none;}
.logo-wordmark{font-size:1.2rem;font-weight:900;letter-spacing:-0.05em;}
.logo-wordmark .als{color:#f0f0f5;}
.logo-wordmark .flow{color:#3b82f6;}
/* ── PAGE ── */
  .page{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:7rem 2rem 4rem;
    position:relative;
    overflow:hidden;
    text-align:center;
  }
/* decorative large background mark */
  .bg-mark{
    position:absolute;
    top:50%;left:50%;
    transform:translate(-50%,-52%);
    opacity:0.035;
    pointer-events:none;
    user-select:none;
  }
/* badge */
  .badge{
    display:inline-flex;align-items:center;gap:0.45rem;
    font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;
    color:var(--blue-light);
    background:rgba(59,130,246,0.1);
    border:1px solid rgba(59,130,246,0.2);
    border-radius:100px;
    padding:0.3rem 0.9rem;
    margin-bottom:2rem;
  }
/* 404 number */
  .error-code{
    font-size:clamp(7rem,22vw,11rem);
    font-weight:900;
    letter-spacing:-0.06em;
    line-height:0.88;
    background:linear-gradient(160deg,var(--t1) 30%,var(--t3) 100%);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    background-clip:text;
    margin-bottom:1.5rem;
    position:relative;
    z-index:1;
  }
.error-title{
    font-size:clamp(1.25rem,3vw,1.75rem);
    font-weight:900;
    letter-spacing:-0.03em;
    margin-bottom:0.65rem;
    position:relative;z-index:1;
  }
.error-desc{
    font-size:0.9rem;
    color:var(--t2);
    line-height:1.75;
    max-width:360px;
    margin:0 auto 2.5rem;
    position:relative;z-index:1;
  }
/* buttons */
  .btn-row{display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;position:relative;z-index:1;}
.btn-home{
    display:inline-flex;align-items:center;gap:0.45rem;
    background:var(--blue);color:#fff;
    font-family:var(--font);font-size:0.875rem;font-weight:700;
    padding:0.7rem 1.6rem;border-radius:10px;
    text-decoration:none;border:none;cursor:pointer;
    box-shadow:0 2px 18px rgba(37,99,235,0.32);
    transition:opacity 0.2s,transform 0.15s;
  }
.btn-home:hover{opacity:0.88;transform:translateY(-1px);}
.btn-secondary{
    display:inline-flex;align-items:center;gap:0.45rem;
    background:transparent;color:var(--t2);
    font-family:var(--font);font-size:0.875rem;font-weight:600;
    padding:0.7rem 1.4rem;border-radius:10px;
    text-decoration:none;
    border:1.5px solid var(--border-h);
    transition:color 0.2s,border-color 0.2s;
  }
.btn-secondary:hover{color:var(--t1);border-color:rgba(255,255,255,0.24);}
/* divider + footer note */
  .divider{width:36px;height:1px;background:var(--border);margin:2.5rem auto 0;}
.footer-note{font-size:0.72rem;color:var(--t3);margin-top:1.25rem;letter-spacing:0.02em;position:relative;z-index:1;}
.nav{padding:1rem 1.5rem;}
.page{padding:6rem 1.5rem 3rem;}
.error-code{line-height:0.85;}
</style>
