---
import Base from "../layouts/Base.astro";
import Zigzag from "../components/Zigzag.astro";
import ChatDemo from "../components/ChatDemo.astro";

/* "Zkuste si to teď" (16. 10.): tři funkce, u každé pár zpráv. Kroky
   ukazují, jak asistent "přemýšlí". Co asistent sám neřeší, čeká na
   schválení. Odpovědi se vždy představí jako AI. */
const demo = {
  name: "AI asistent ukázkové ordinace",
  botLabel: "AI asistent",
  idle: "Vyberte zprávu vlevo…",
  functions: [
    { id: "email", label: "E-mailové odpovědi", color: "var(--cyan)", name: "Schránka ukázkové ordinace",
      desc: "Pomůže, když vám odpovídání na e-maily bere večery.",
      messages: [
        { from: "Kateřina Nováková", time: "e-mail · 19:12", text: "Dobrý den, máte volný termín tento týden?",
          steps: ["Čte e-mail", "Kontroluje kalendář", "Píše vaším tónem"],
          reply: "Dobrý den, Kateřino, ve středu od 10:00 a ve čtvrtek od 14:00 mám volno. Hodí se vám některý z termínů? Píše vám AI asistent ordinace." },
        { from: "Marek Svoboda", time: "e-mail · 20:40", text: "Kolik stojí první návštěva a jak dlouho trvá?",
          steps: ["Čte e-mail", "Hledá v ceníku"],
          reply: "Dobrý den, Marku, první návštěva stojí 850 Kč a trvá zhruba 45 minut. Chcete rovnou naplánovat termín? Píše vám AI asistent ordinace." },
        { from: "Petra K.", time: "e-mail · 21:05", text: "Dáte mi slevu, když přijdu i s kamarádkou?",
          steps: ["Čte e-mail", "Sleva není v podkladech", "Nechá to na vás"],
          reply: "Dobrý den, na tohle vám odpoví přímo majitelka, předal jsem jí váš dotaz. Píše vám AI asistent ordinace.",
          end: "approve", endText: "Dotaz čeká na vás", doneText: "Hotovo, převzali jste to" },
      ] },
    { id: "rez", label: "Rezervace a připomínky", color: "var(--blue)", name: "WhatsApp ukázkové ordinace",
      desc: "Pomůže, když zvoní telefon, zatímco máte klienta.",
      messages: [
        { from: "WhatsApp", time: "18:30", text: "Kdy máte volno tento týden?",
          steps: ["Kontroluje kalendář", "Našel 5 volných časů"],
          reply: "Volno je ve středu v 10:00 a 15:30, ve čtvrtek v 9:00 a 14:00 a v pátek v 11:00. Který vám vyhovuje? Píše vám AI asistent." },
        { from: "WhatsApp", time: "18:34", text: "Zarezervuj mi pátek 14:00.",
          steps: ["Ověří, že je volno", "Zapíše do kalendáře", "Naplánuje připomínku"],
          reply: "Hotovo, pátek 14:00 je váš. Potvrzení vám přijde e-mailem a ve čtvrtek večer pošlu připomínku. Píše vám AI asistent.",
          endText: "Hotovo, zapsáno do kalendáře" },
        { from: "WhatsApp", time: "07:50", text: "Musím zrušit čtvrteční termín, omlouvám se.",
          steps: ["Najde termín", "Uvolní ho v kalendáři"],
          reply: "Nevadí, čtvrteční termín jsem zrušil. Chcete rovnou najít náhradní? Píše vám AI asistent.",
          endText: "Hotovo, termín je volný pro další" },
      ] },
    { id: "rate", label: "Zpětná vazba", color: "var(--violet)", soon: true, name: "Recenze ukázkové ordinace",
      desc: "Pomůže, když chcete víc recenzí a klienty, kteří se vrací.",
      messages: [
        { from: "Hodnocení ★★★★★", time: "Google", text: "Skvělá péče, odcházela jsem spokojená. Určitě se vrátím.",
          steps: ["Přečte hodnocení", "Navrhne poděkování"],
          reply: "Moc děkujeme za hezká slova, těšíme se na vás. Kdybyste chtěla rovnou další termín, stačí odpovědět.",
          end: "approve", endText: "Odpověď čeká na schválení", doneText: "Hotovo, odpověď zveřejněna" },
        { from: "Hodnocení ★★★★☆", time: "Google", text: "Ošetření super, ale čekala jsem skoro dvacet minut.",
          steps: ["Přečte hodnocení", "Pozná výtku", "Navrhne omluvu"],
          reply: "Omlouváme se za čekání, mrzí nás to. Děkujeme, že jste nám to napsala, dáme si na to pozor.",
          end: "approve", endText: "Odpověď čeká na schválení", doneText: "Hotovo, odpověď zveřejněna" },
      ] },
  ],
};
---
<Base
  title="AI asistenti pro malé firmy a živnostníky | ALSflow"
  description="Asistent odpovídá zákazníkům, objednává termíny a připomíná je, česky a vaším tónem. Od 2 500 Kč měsíčně, nasazení do 5 až 7 dnů."
  canonical="https://alsflow.cz/ai-asistenti"
  ogDescription="Váš e-mail. Váš kalendář. Váš AI. Nastavím vše za vás, vy se staráte o klienty."
  current="/ai-asistenti"
>
  <Fragment slot="head">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "ALSflow",
    "legalName": "Jakub Ryvola",
  "taxID": "30112702",
    "url": "https://alsflow.cz",
    "image": "https://alsflow.cz/og-image.png",
    "description": "AI asistent pro živnostníky, automatizace e-mailů, rezervací a zákaznické komunikace.",
    "telephone": "+420770162346",
    "email": "info@alsflow.cz",
    "priceRange": "2500-7500 CZK",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Předenická 684/17, Písnice",
      "addressLocality": "Praha 4",
      "postalCode": "142 00",
      "addressCountry": "CZ"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@alsflow.cz",
      "telephone": "+420770162346",
      "contactType": "customer service",
      "availableLanguage": "Czech"
    },
    "areaServed": "Praha",
    "sameAs": [
      "https://www.instagram.com/als.flow"
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "AI automatizace pro malé firmy",
    "provider": { "@type": "Organization", "name": "ALSflow" },
    "areaServed": "CZ",
    "description": "Automatizace e-mailových odpovědí, online rezervací a zpětné vazby pro kadeřníky, fyzioterapeuty, veterináře a zubní ordinace.",
    "offers": [
      { "@type": "Offer", "name": "E-mailové odpovědi", "price": "2500", "priceCurrency": "CZK" },
      { "@type": "Offer", "name": "Rezervace & Připomínky", "price": "4500", "priceCurrency": "CZK" },
      { "@type": "Offer", "name": "Kompletní balíček", "price": "7500", "priceCurrency": "CZK" }
    ]
  }
  </script>
  <!-- úvodní loader - jediný zdroj je tenhle obal, samostatný soubor už neexistuje -->
<script>
  /* Běží co nejdřív, ještě před vykreslením obsahu - jinak by loader
     naskočil až na chvíli hotovou stránku a probliklo by to. */
  (function () {
    try {
      if (sessionStorage.getItem('als-seen')) return;
    } catch (e) {
      /* privátní okno nebo zakázané úložiště - loader prostě ukážeme */
    }
    document.documentElement.classList.add('als-loading');
  })();
</script>
  </Fragment>


  <section class="hero-plain hero-move">
    <canvas class="scene scene-wide" data-dotwave aria-hidden="true"></canvas>
    <div class="wrap">
      <h1 class="h-hero fade-head reveal-words" style="max-width:16ch">Z&aacute;kazn&iacute;k p&iacute;&scaron;e. <span class="grad">Asistent odpov&iacute;d&aacute;.</span></h1>
      <p class="lead">Odpovídá zákazníkům, zapisuje termíny a připomíná je. Na WhatsAppu, e-mailu i webu, vaším tónem. Nastavím to za vás.</p>
      <div class="btn-row">
        <a class="btn btn-grad btn-shine" href="/kontakt">Nez&aacute;vazn&aacute; nab&iacute;dka</a>
        <a class="btn btn-magnet" href="#ukazka">Vyzkou&scaron;et &zcaron;iv&ecaron; <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></a>
      </div>
      <div class="facts">
        <span class="fact">Od <b>2&nbsp;500 K&ccaron;</b>/m&ecaron;s</span>
        <span class="fact">Spu&scaron;t&ecaron;n&iacute; do <b>5 a&zcaron; 7 pracovn&iacute;ch dn&uring;</b></span>
        <span class="fact">Bez z&aacute;vazku, <b>zru&scaron;&iacute;te kdykoli</b></span>
      </div>
    </div>
  </section>

  <section class="sec sec-line" id="cenik">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Veřejné <span class="grad">ceny</span>.</h2>
        <p class="lead">M&ecaron;s&iacute;&ccaron;n&ecaron;, bez z&aacute;vazku, zru&scaron;&iacute;te kdykoli. Nejsem plátce DPH, ceny jsou konečné.</p>
      </div>
      <div class="bots">
        <article class="aibot rev from-l" style="--c: var(--cyan)">
          <div class="bot-art" aria-hidden="true">
            <div class="ba-mail"><b>Kateřina N.</b><span>Máte volný termín tento týden?</span></div>
            <div class="ba-mail"><b>Marek S.</b><span>Kolik stojí první návštěva?</span></div>
            <div class="ba-mail ba-ai"><b>AI návrh</b><span>Dobrý den, ve středu od 10:00…</span></div>
            <span class="bot-tag" style="--i: 0; top: -1rem; right: 8%">1 500 e-mailů v ceně</span>
            <span class="bot-tag" style="--i: 1; bottom: 42%; left: -1.2rem">Gmail i Outlook</span>
            <span class="bot-tag bot-tag--ghost" style="--i: 2; bottom: -1rem; right: 12%">Nejistý dotaz nechá na vás</span>
          </div>
          <div class="bot-copy">
            <h3>E-mailové odpovědi</h3>
            <p>Čte poštu, odpovídá na běžné dotazy vaším tónem a co nezná, předá vám.</p>
            <p class="bot-cost"><b>2&nbsp;500&nbsp;Kč</b> / měsíc</p>
            <a class="btn btn-svc" style="--c: var(--cyan)" href="/kontakt?sluzba=ai">Chci tenhle</a>
          </div>
        </article>
        <article class="aibot bot--r rev from-r" style="--c: var(--blue)">
          <div class="bot-art" aria-hidden="true">
            <div class="ba-cal">
              <span>Po</span><span>Út</span><span>St</span><span>Čt</span><span>Pá</span>
              <i></i><i class="x"></i><i></i><i class="x"></i><i></i>
              <i class="x"></i><i></i><i class="x"></i><i></i><i class="hit">14:00</i>
            </div>
            <div class="ba-wa">Pátek 14:00 je váš &#10003;</div>
            <span class="bot-tag" style="--i: 0; top: -1rem; left: 10%">Nejčastěji</span>
            <span class="bot-tag" style="--i: 1; top: 40%; right: -1rem">Rovnou do Google Kalendáře</span>
            <span class="bot-tag bot-tag--ghost" style="--i: 2; bottom: -1rem; left: 14%">Připomínka den předem</span>
          </div>
          <div class="bot-copy">
            <h3>Rezervace a připomínky</h3>
            <p>Objedná termín přes WhatsApp i web, zapíše ho do kalendáře, den předem připomene. Přesun i zrušení bez telefonu. 750 rezervací měsíčně v ceně.</p>
            <p class="bot-cost"><b>4&nbsp;500&nbsp;Kč</b> / měsíc</p>
            <a class="btn btn-svc" style="--c: var(--blue)" href="/kontakt?sluzba=ai">Chci tenhle</a>
          </div>
        </article>
        <article class="aibot rev from-l" style="--c: var(--violet)">
          <div class="bot-art" aria-hidden="true">
            <div class="ba-rev"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span><b>Skvělá péče</b><span>Určitě se vrátím.</span></div>
            <div class="ba-rev ba-ai"><b>Návrh odpovědi</b><span>Moc děkujeme, těšíme se na vás.</span></div>
            <span class="bot-tag" style="--i: 0; top: -1rem; right: 10%">Připravuji</span>
            <span class="bot-tag bot-tag--ghost" style="--i: 1; bottom: -1rem; left: 10%">Pozve na další termín</span>
          </div>
          <div class="bot-copy">
            <h3>Zpětná vazba</h3>
            <p>Po návštěvě se zeptá na spokojenost, navrhne odpověď na recenzi a pozve na další termín. Měsíční přehled hodnocení.</p>
            <p class="bot-cost"><b>2&nbsp;500&nbsp;Kč</b> / měsíc</p>
            <a class="btn btn-quiet" href="/zpetna-vazba">Zjistit víc</a>
          </div>
        </article>
      </div>
      <div class="price-line" style="margin-top:2.5rem">
        <div><div class="k">V&scaron;echno dohromady</div><div class="v">7&nbsp;500 K&ccaron;/m&ecaron;s</div></div>
        <div><div class="k">Jednor&aacute;zov&eacute; nastaven&iacute;</div><div class="v">8 000–10 000 Kč</div></div>
        <div><div class="k">Spu&scaron;t&ecaron;n&iacute;</div><div class="v">do 5 a&zcaron; 7 pracovn&iacute;ch dn&uring;</div></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-fill" href="/kontakt">Chci nez&aacute;vaznou nab&iacute;dku <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></a>
      </div>
    </div>
  </section>

  <section class="sec sec-dark sec-line" id="ukazka">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Zkuste si to <span class="grad">teď</span></h2>
        <p class="lead">Vyberte, co vás nejvíc zdržuje, a klikněte na zprávu od zákazníka. Uvidíte, jak asistent zprávu přečte, co si ověří a co odpoví. A co sám neřeší, nechá na vás ke schválení.</p>
      </div>
      <ChatDemo config={demo} hint="Klikněte na zprávu" />
      <p class="small-note">Odpovědi v ukázce jsou připravené dopředu. Živou asistentku Kláru najdete v chatu vpravo dole.</p>
    </div>
  </section>

  <section class="sec sec-line" id="pro-koho">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Pro koho asistenta <span class="grad">stavím</span></h2>
        <p class="lead">Nej&ccaron;ast&ecaron;ji to &rcaron;e&scaron;&iacute; provozy, kde majitel pracuje rukama a k telefonu se nedostane.</p>
      </div>
      <div class="cards-3 cards-4">
        <div class="panel panel-pad panel-glow panel-sheen tilt rev"><h3 style="margin:0 0 0.45rem;font-size:1rem">Fyzioterapeuti</h3><p style="font-size:0.89rem;line-height:1.6;color:var(--t2)">M&iacute;&ncaron; telefon&aacute;t&uring; a m&iacute;&ncaron; e-mail&uring;. Vy se v&ecaron;nujete klientovi na leh&aacute;tku, zbytek vy&rcaron;&iacute;d&iacute; asistent.</p></div>
          <div class="panel panel-pad panel-glow panel-sheen tilt rev" data-d="1"><h3 style="margin:0 0 0.45rem;font-size:1rem">Kade&rcaron;nictv&iacute; a salony</h3><p style="font-size:0.89rem;line-height:1.6;color:var(--t2)">Žádné zmeškané rezervace. Asistent p&rcaron;ijme objedn&aacute;vku i v sobotu ve&ccaron;er, kdy&zcaron; jste u z&aacute;kazn&iacute;ka.</p></div>
          <div class="panel panel-pad panel-glow panel-sheen tilt rev" data-d="2"><h3 style="margin:0 0 0.45rem;font-size:1rem">Veterin&aacute;&rcaron;i</h3><p style="font-size:0.89rem;line-height:1.6;color:var(--t2)">Zákazníci se ptají a rezervuj&iacute; kdykoli, ani&zcaron; by vyru&scaron;ovali ordinaci nebo no&ccaron;n&iacute; slu&zcaron;bu.</p></div>
          <div class="panel panel-pad panel-glow panel-sheen tilt rev" data-d="3"><h3 style="margin:0 0 0.45rem;font-size:1rem">Zubn&iacute; ordinace</h3><p style="font-size:0.89rem;line-height:1.6;color:var(--t2)">Asistent odpov&iacute;d&aacute; na dotazy, potvrzuje term&iacute;ny a pos&iacute;l&aacute; p&rcaron;ipom&iacute;nky. Recepce, kter&aacute; nikdy nesp&iacute;.</p></div>
      </div>
      <p class="lead" style="margin-top:2rem">A jak&yacute;koli dal&scaron;&iacute; &zcaron;ivnostn&iacute;k, kter&yacute; nechce p&rcaron;ich&aacute;zet o z&aacute;kazn&iacute;ky proto, &zcaron;e nest&iacute;h&aacute; odpov&iacute;dat.</p>
    </div>
  </section>

  <!-- Podrobnejsi stranky. Byly osirele: v novem designu na ne neodkazovala
       ani jedna stranka, takze jim Google prestaval prisuzovat vahu. -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Co asistent <span class="grad">dok&aacute;&zcaron;e</span></h2>
        <p class="lead">Ka&zcaron;d&aacute; slu&zcaron;ba m&aacute; vlastn&iacute; str&aacute;nku s postupem, cenou a t&iacute;m, co je v pau&scaron;&aacute;lu.</p>
      </div>
      <div class="cards-2">
        <a class="panel panel-pad tilt rev ai-c" href="/e-mailove-odpovedi" style="--c: var(--cyan)">
          <h3>E-mailov&eacute; odpov&ecaron;di</h3>
          <p>Asistent &ccaron;te a odpov&iacute;d&aacute; na z&aacute;kaznick&eacute; e-maily &ccaron;esky a va&scaron;&iacute;m t&oacute;nem.</p>
          <span class="ai-more">Zjistit v&iacute;c &rarr;</span>
        </a>
        <a class="panel panel-pad tilt rev ai-c" data-d="1" href="/rezervace-pripominky" style="--c: var(--blue)">
          <h3>Rezervace a p&rcaron;ipom&iacute;nky</h3>
          <p>Objedn&aacute;n&iacute; nonstop, potvrzen&iacute; term&iacute;nu a p&rcaron;ipom&iacute;nka den p&rcaron;edem.</p>
          <span class="ai-more">Zjistit v&iacute;c &rarr;</span>
        </a>
        <a class="panel panel-pad tilt rev ai-c" data-d="2" href="/zpetna-vazba" style="--c: var(--violet)">
          <h3>Zp&ecaron;tn&aacute; vazba <span class="ai-tag ai-tag--soon">Připravuji</span></h3>
          <p>Dotaz po n&aacute;v&scaron;t&ecaron;v&ecaron;, odpov&ecaron;&dcaron; na recenzi a pozv&aacute;nka zp&aacute;tky.</p>
          <span class="ai-more">Zjistit v&iacute;c &rarr;</span>
        </a>
        <a class="panel panel-pad tilt rev ai-c" data-d="3" href="/ai-asistent-pro-fyzioterapeuty" style="--c: var(--green)">
          <h3>Pro fyzioterapeuty</h3>
          <p>M&eacute;n&ecaron; nenastoupen&yacute;ch term&iacute;n&uring; a di&aacute;&rcaron;, kter&yacute; se pln&iacute; s&aacute;m.</p>
          <span class="ai-more">Zjistit v&iacute;c &rarr;</span>
        </a>
        <a class="panel panel-pad tilt rev ai-c" data-d="4" href="/ai-asistent-pro-kadernictvi" style="--c: var(--amber)">
          <h3>Pro kade&rcaron;nictv&iacute;</h3>
          <p>Objedn&aacute;v&aacute;n&iacute; i mimo otev&iacute;rac&iacute; dobu, bez p&rcaron;eru&scaron;ov&aacute;n&iacute; pr&aacute;ce.</p>
          <span class="ai-more">Zjistit v&iacute;c &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="sec-line" style="padding:3.4rem 0">
    <div class="wrap">
      <div class="marquee rev">
