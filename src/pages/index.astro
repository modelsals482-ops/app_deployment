        </a>
        <a href="https://weloveevents.cz" target="_blank" rel="noopener" aria-label="weloveevents.cz">
          <img src="/assets/ref/wle-logo.png" alt="WE LOVE EVENTS" width="118" height="36" loading="lazy" />
        </a>
      </div>
      <div class="btn-row rev" data-d="2" style="justify-content:center">
        <a class="btn btn-trace" href="/tvorba-webu">Podívat se na weby</a>
      </div>
    </div>
  </section>


  <section class="sec-line" style="padding:3.4rem 0">
