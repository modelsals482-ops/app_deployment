  <!-- Smooth (inertia) scroll — same Lenis config as weloveevents.cz. Self-hosted so it passes the
       site's CSP (script-src 'self'). Loads in order, so Lenis is defined when the init runs below. -->
  <script is:inline src="/lenis.min.js"></script>
  <script is:inline>
    (function(){
      "use strict";
      // alsScrollTo(target): used by hero/CTA buttons so programmatic jumps go through Lenis
      // (avoids fighting the native smooth-scroll once Lenis owns wheel/touch). Falls back to native.
      window.alsScrollTo = function(target){
        var el = typeof target === "string" ? document.querySelector(target) : target;
        if(!el) return;
        if(window.__lenis){ window.__lenis.scrollTo(el, { offset: 0, duration: 1.2 }); }
        else { el.scrollIntoView({ behavior: "smooth" }); }
      };
      if(window.matchMedia("(prefers-reduced-motion: reduce)").matches) return; // keep native scroll
      if(typeof Lenis === "undefined") return; // script failed to load -> silently keep native scroll
      var lenis = new Lenis({ lerp: 0.09, wheelMultiplier: 1, smoothWheel: true });
      window.__lenis = lenis;
      function raf(time){ lenis.raf(time); requestAnimationFrame(raf); }
      requestAnimationFrame(raf);
    })();
  </script>

