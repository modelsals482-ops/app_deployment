---
import Base from "../layouts/Base.astro";
import ChatDemo from "../components/ChatDemo.astro";

/* Ukázka asistenta na úvodu: jeden ukázkový salon, tři zprávy. Poslední
   asistent sám neřeší, ukazatel proto čeká na "Schválit". */
const demo = {
  name: "Asistent ukázkového salonu",
  botLabel: "AI asistent salonu",
  idle: "Čekám na zprávu od zákazníka…",
  functions: [{
    id: "salon", label: "Salon", desc: "", color: "var(--blue)",
    messages: [
      { from: "Zákaznice", time: "21:40", text: "Dobrý den, máte v sobotu volno na barvení?",
        steps: ["Čte zprávu", "Kontroluje kalendář", "Našel 2 volné termíny"],
        reply: "Dobrý den, v sobotu je volno v 9:00 a ve 13:30. Mám vám jeden z těch časů zapsat? Barvení trvá zhruba dvě hodiny. Píše vám AI asistent salonu.",
        endText: "Hotovo, odpovězeno za 4 s" },
      { from: "Zákazník", time: "22:05", text: "Kolik u vás stojí střih a vousy?",
        steps: ["Čte zprávu", "Hledá v ceníku"],
        reply: "Dobrý den, střih s úpravou vousů stojí 650 Kč a trvá 45 minut. Pokud chcete, rovnou vám najdu volný termín. Píše vám AI asistent salonu.",
        endText: "Hotovo, odpovězeno za 3 s" },
      { from: "Zákaznice", time: "22:30", text: "Minule mi barva nechytla tak, jak jsme se domluvily. Co s tím?",
        steps: ["Čte zprávu", "Pozná stížnost", "Tohle nechá na vás"],
        reply: "Dobrý den, mrzí mě to. Předal jsem vaši zprávu majitelce salonu a ozve se vám osobně. Píše vám AI asistent salonu.",
        end: "approve", endText: "Shrnutí čeká na vás", doneText: "Hotovo, majitelka to převzala" },
    ],
  }],
};
---
<Base
  title="ALSflow: weby, software a AI asistenti pro malé firmy"
  description="Weby, software na míru a AI asistenti pro české živnostníky a malé firmy. Cena podle toho, co opravdu potřebujete, rychlá odpověď, provoz zajistíme. Praha."
  canonical="https://alsflow.cz/"
  ogDescription="Tři věci, které dělám: weby, software na míru a AI asistenty. Samostatně i v balíčku, rychlá odpověď."
>
  <Fragment slot="head">
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "ALSflow",
  "legalName": "Jakub Ryvola",
  "taxID": "30112702",
  "url": "https://alsflow.cz",
  "email": "info@alsflow.cz",
  "description": "Weby, software na míru a AI asistenti pro české živnostníky a malé firmy. Rychlá odpověď, provoz zajištěn.",
  "areaServed": [
    "CZ",
    "SK"
  ],
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Předenická 684/17",
    "postalCode": "142 00",
    "addressLocality": "Praha 4",
    "addressCountry": "CZ"
  },
  "makesOffer": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Tvorba webových stránek",
        "url": "https://alsflow.cz/tvorba-webu"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Vývoj softwaru na míru",
        "url": "https://alsflow.cz/vyvoj-softwaru"
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "AI asistenti",
        "url": "https://alsflow.cz/ai-asistenti"
      }
    }
  ]
}
  </script>
  <!-- úvodní loader - jediný zdroj je tenhle obal, samostatný soubor už neexistuje -->
<script>
  /* Běží co nejdřív, ještě před vykreslením obsahu - jinak by loader
     naskočil až na chvíli hotovou stránku a probliklo by to. */
  (function () {
    try {
      if (sessionStorage.getItem('als-seen')) return;
    } catch (e) {
      /* privátní okno nebo zakázané úložiště - loader prostě ukážeme */
    }
    document.documentElement.classList.add('als-loading');
  })();
</script>
  <link rel="stylesheet" href="/assets/css/showcase.css" />
  <link rel="stylesheet" href="/assets/css/chatdemo.css" />
  <link rel="stylesheet" href="/assets/css/home.css" />
  </Fragment>

  <section class="hero">
    <div class="hero-stage">
      <!-- Skládané sklo (glassfold.js). Svítící prstence se přestěhovaly do Kontaktu. -->
      <canvas data-glassfold aria-hidden="true"></canvas>
    </div>
    <div class="wrap">
      <!-- Koláž skutečných webů vpravo, svítící prstence za ní. Celá je
           odkaz do referencí. Pod 1100 px se schová, text má přednost. -->
      <a class="hero-collage" href="/reference" aria-label="Ukázky mé práce v referencích">
        <figure class="pm pm-main" style="--i: 0">
          <span class="pm-bar" aria-hidden="true"><i></i><i></i><i></i><b>weloveproduction.cz</b></span>
          <img src="/assets/ref/wlp-home.webp" alt="" width="1200" height="750" decoding="async" fetchpriority="high" />
        </figure>
        <figure class="pm pm-second" style="--i: 1">
          <span class="pm-bar" aria-hidden="true"><i></i><i></i><i></i><b>gen1.cz</b></span>
          <img src="/assets/ref/gen-home.webp" alt="" width="1200" height="750" decoding="async" />
        </figure>
        <figure class="pm pm-phone" style="--i: 2">
          <img src="/assets/ref/sek-m.webp" alt="" width="360" height="779" decoding="async" />
        </figure>
        <span class="hc-tag" style="--i: 3">Moje reference &rarr;</span>
      </a>
      <div class="hero-copy hero-copy--wide">
        <h1 class="h-hero fade-head reveal-words">Víc poptávek, <span class="grad">méně</span> ruční práce</h1>
        <p class="lead">Postavím vám web, software na míru nebo AI asistenta. Osobně, s&nbsp;cenou předem a s&nbsp;přehledem v&nbsp;číslech každý měsíc, ať vidíte, co vám to přináší.</p>
        <div class="btn-row">
          <a class="btn btn-grad btn-shine" href="/kontakt">Chci nezávaznou nabídku</a>
          <a class="btn btn-magnet" href="#ukazka">Vyzkoušet asistenta <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></a>
        </div>
        <div class="facts">
          <span class="fact">Odpovím do <b>48 hodin</b> v pracovní dny</span>
          <span class="fact">Web od <b>14&nbsp;900&nbsp;Kč</b></span>
          <span class="fact">Asistent od <b>2&nbsp;500&nbsp;Kč</b>/měs</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-line" id="co-delame">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Co pro vás postavím</h2>
        <p class="lead">Vyberte, co řešíte. Do nabídky napíšu termín a přesnou cenu, nezávazně a do 48 hodin.</p>
      </div>
      <div class="svc-cards">
        <a class="panel panel-pad svc-card rev" href="/tvorba-webu" style="--c: var(--cyan)">
          <span class="svc-bub" aria-hidden="true">od 14 900 Kč</span>
          <div class="svc-head"><h3>Weby</h3><p class="svc-hook">Web, přes který vám zákazníci zavolají a pošlou poptávku.</p><span class="svc-tag">Bez WordPressu a pluginů</span></div>
          <div class="svc-body">
            <ul class="svc-list"><li>Návrh, texty a spuštění na vaší doméně</li><li>Rychlý a čitelný na mobilu</li><li>Bez pluginů, které je potřeba aktualizovat</li></ul>
            <dl class="svc-meta"><div><dt>Spuštění</dt><dd>do 6-10 pracovních dnů</dd></div><div><dt>Cena</dt><dd>od 14&nbsp;900&nbsp;Kč, provoz od 990&nbsp;Kč/měs</dd></div></dl>
            <span class="svc-more">Jak to funguje <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></span>
          </div>
        </a>
        <a class="panel panel-pad svc-card rev" data-d="1" href="/vyvoj-softwaru" style="--c: var(--blue)">
          <span class="svc-bub" aria-hidden="true">od 24 900 Kč</span>
          <div class="svc-head"><h3>Software na míru</h3><p class="svc-hook">Jeden přehledný nástroj místo přepisování mezi tabulkami a e-maily.</p><span class="svc-tag">Kód a účty na vaše jméno</span></div>
          <div class="svc-body">
            <ul class="svc-list"><li>Administrace a interní nástroje</li><li>Propojení systémů, které spolu dnes nemluví</li><li>Zdrojový kód a účty na vaše jméno</li></ul>
            <dl class="svc-meta"><div><dt>Spuštění</dt><dd>podle rozsahu, obvykle týdny</dd></div><div><dt>Cena</dt><dd>od 24&nbsp;900&nbsp;Kč</dd></div></dl>
            <span class="svc-more">Jak to funguje <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></span>
          </div>
        </a>
        <a class="panel panel-pad svc-card rev" data-d="2" href="/ai-asistenti" style="--c: var(--violet)">
          <span class="svc-bub" aria-hidden="true">od 2 500 Kč/měs</span>
          <div class="svc-head"><h3>AI asistenti</h3><p class="svc-hook">Odpoví zákazníkům a zapíše termíny, i když jste zrovna u práce.</p><span class="svc-tag">Vždy se představí jako AI</span></div>
          <div class="svc-body">
            <ul class="svc-list"><li>Na WhatsAppu, e-mailu nebo webu, které už máte</li><li>Vždy se představí jako AI</li><li>Měsíční platba, bez závazků</li></ul>
            <dl class="svc-meta"><div><dt>Spuštění</dt><dd>do 5-7 pracovních dnů</dd></div><div><dt>Cena</dt><dd>od 2&nbsp;500&nbsp;Kč/měs</dd></div></dl>
            <span class="svc-more">Jak to funguje <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></span>
          </div>
        </a>
      </div>
      <div class="svc-act panel panel-pad rev" data-d="3" id="poptavka">
        <div class="svc-act-copy">
          <h3>Pošlete poptávku</h3>
          <p>Klikněte na to, co potřebujete. Do 48 hodin vám pošlu termín a přesnou cenu, nezávazně.</p>
        </div>
        <div class="svc-act-btns">
          <a class="btn btn-svc" style="--c: var(--cyan)" href="/kontakt?sluzba=web">Chci web</a>
          <a class="btn btn-svc" style="--c: var(--blue)" href="/kontakt?sluzba=software">Chci software</a>
          <a class="btn btn-svc" style="--c: var(--violet)" href="/kontakt?sluzba=ai">Chci AI asistenta</a>
          <a class="btn" href="/kontakt?sluzba=nevim">Nevím, poraďte mi</a>
        </div>
        <p class="svc-act-alt">Raději hned? Zavolejte <a href="tel:+420770162346">+420 770 162 346</a> · <a href="/cenik">Celý ceník</a></p>
      </div>
      <!-- Tri hotovi asistenti viseli jen na /ai-asistenti, z titulni strany
           na ne nevedla zadna cesta. Radka je zamerne tiche pismo, hlavni
           rozcestnik zustavaji tri karty vyse. -->
      <p class="rev" data-d="3" style="margin-top:1.6rem;text-align:center;font-size:0.88rem;color:var(--t3)">Asistenti: <a href="/e-mailove-odpovedi">E-mailov&eacute; odpov&ecaron;di</a> &middot; <a href="/rezervace-pripominky">Rezervace a p&rcaron;ipom&iacute;nky</a> &middot; <a href="/zpetna-vazba">Zp&ecaron;tn&aacute; vazba</a> (připravuji)</p>
    </div>
  </section>


  <section class="sec sec-line" id="ukazka">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Vyzkoušejte si <span class="grad">asistenta</span></h2>
        <p class="lead">Je neděle večer a vy máte volno. Do salonu přišly tři zprávy. Klikněte na kteroukoli a sledujte, co s&nbsp;ní asistent udělá.</p>
      </div>
      <ChatDemo config={demo} />
      <p class="small-note">Asistent se zákazníkům vždy představí jako AI. Co neumí, předá vám. <a href="/ai-asistenti#ukazka">Víc ukázek</a></p>
    </div>
  </section>

  <section class="sec sec-dark runs-sec">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Co už <span class="grad">běží</span></h2>
        <p class="lead">Skutečné weby a asistentka, které jsem postavil a dál se o ně starám.</p>
      </div>
      <div class="live-grid">
        <a class="live rev from-l" href="/reference#gen" style="--c: var(--violet)">
          <div class="live-media">
            <figure class="pm pm-main"><span class="pm-bar" aria-hidden="true"><i></i><i></i><i></i><b>gen1.cz</b></span><img src="/assets/ref/gen1-program.webp" alt="Web gen1.cz, stránka programu" width="1200" height="750" loading="lazy" decoding="async" /></figure>
            <figure class="pm pm-phone"><img src="/assets/ref/gen1-m.webp" alt="" width="360" height="779" loading="lazy" decoding="async" /></figure>
            <span class="live-tag" style="--i: 0">Aktuality si píše samo</span>
          </div>
          <h3>gen1.cz</h3><p>Politické hnutí, Praha 1</p>
        </a>
        <a class="live rev" data-d="1" href="/reference#sekelova" style="--c: var(--amber)">
          <div class="live-media">
            <figure class="pm pm-main"><span class="pm-bar" aria-hidden="true"><i></i><i></i><i></i><b>znalecsekelova.sk</b></span><img src="/assets/ref/sek-sluzby.webp" alt="Web znalecsekelova.sk, stránka služeb" width="1200" height="750" loading="lazy" decoding="async" /></figure>
            <figure class="pm pm-phone"><img src="/assets/ref/sek-m.webp" alt="" width="360" height="779" loading="lazy" decoding="async" /></figure>
            <span class="live-tag" style="--i: 1">Celý ve slovenštině</span>
          </div>
          <h3>znalecsekelova.sk</h3><p>Soudní znalkyně, Slovensko</p>
        </a>
        <a class="live rev from-r" data-d="2" href="/reference#alsflow" style="--c: var(--cyan)">
          <div class="live-media">
            <figure class="pm pm-main"><span class="pm-bar" aria-hidden="true"><i></i><i></i><i></i><b>alsflow.cz</b></span><img src="/assets/ref/als-home.webp" alt="Úvodní stránka alsflow.cz s Klárou" width="1200" height="750" loading="lazy" decoding="async" /></figure>
            <span class="live-chat">Klára · AI<b>Web začíná od 14 900 Kč. Mám Jakubovi předat kontakt?</b></span>
            <span class="live-tag" style="--i: 2">Představí se jako AI</span>
          </div>
          <h3>Klára</h3><p>AI asistentka tady vpravo dole</p>
        </a>
      </div>
      <p class="small-note rev" style="text-align:center">A rental techniky pro We Love Events, veřejně brzy. <a href="/reference">Všechny reference &rarr;</a></p>
    </div>
  </section>

  <section class="sec sec-line call-sec" data-inview>
    <div class="wrap call-grid">
      <div>
        <h2 class="h-sec fade-head reveal-words">Zvednu <span class="grad">telefon</span>. Zbytek je na mně.</h2>
        <p class="lead">Jednáte se mnou, ne s&nbsp;call centrem. Od vás potřebuju čtvrt hodiny a pár odpovědí.</p>
        <div class="call-tags">
          <span style="--c: var(--cyan); --i: 0">Jeden dodavatel na všechno</span>
          <span style="--c: var(--violet); --i: 1">Cena předem</span>
          <span style="--c: var(--green); --i: 2">Všechno na vaše jméno</span>
          <span style="--c: var(--amber); --i: 3">Provoz v paušálu</span>
        </div>
        <div class="btn-row">
          <a class="btn btn-grad" href="/kontakt">Začít hovorem</a>
          <a class="btn btn-magnet" href="tel:+420770162346">+420 770 162 346</a>
          <a class="btn-quiet" href="/o-nas">Víc o mně &rarr;</a>
        </div>
      </div>
      <ol class="call-steps">
        <li style="--c: var(--cyan); --i: 0"><b>Hovor, čtvrt hodiny</b><span>Řeknete, co vás zdržuje.</span></li>
        <li style="--c: var(--blue); --i: 1"><b>Návrh a cena</b><span>Co postavím a za kolik. Nezávazně.</span></li>
        <li style="--c: var(--violet); --i: 2"><b>Náhled během stavby</b><span>Vidíte rozpracovanou verzi na odkazu.</span></li>
        <li style="--c: var(--green); --i: 3"><b>Spuštění a správa</b><span>Web do 6-10 pracovních dnů, asistent do 5-7.</span></li>
      </ol>
    </div>
  </section>

  <div class="word-label">Postavené na ověřených nástrojích</div>
  <div class="word-marq marquee" aria-label="Vercel, Cloudflare, Gemini, WhatsApp Business, Google Workspace, PostgreSQL, Node.js">
    <div class="marquee-track" aria-hidden="true">
      <span style="--mc: var(--cyan)">Vercel</span><span style="--mc: var(--blue)">Cloudflare</span><span style="--mc: var(--violet)">Gemini</span><span style="--mc: var(--green)">WhatsApp Business</span><span style="--mc: var(--amber)">Google Workspace</span><span style="--mc: var(--cyan)">PostgreSQL</span><span style="--mc: var(--blue)">Node.js</span>
      <span style="--mc: var(--cyan)">Vercel</span><span style="--mc: var(--blue)">Cloudflare</span><span style="--mc: var(--violet)">Gemini</span><span style="--mc: var(--green)">WhatsApp Business</span><span style="--mc: var(--amber)">Google Workspace</span><span style="--mc: var(--cyan)">PostgreSQL</span><span style="--mc: var(--blue)">Node.js</span>
    </div>
  </div>

  <section class="closer">
    <div class="wrap">
      <h2 class="h-sec fade-head reveal-words">&Rcaron;ekn&ecaron;te, co pot&rcaron;ebujete.</h2>
      <p class="lead lead-center rev" data-d="1">Nez&aacute;vazn&yacute; hovor na &ccaron;tvrt hodiny. Probereme, co potřebujete, a navrhnu řešení i cenu.</p>
      <div class="btn-row rev" data-d="2" style="justify-content:center">
        <a class="btn btn-grad btn-shine" href="/kontakt">Domluvit 15min hovor</a>
        <a class="btn btn-quiet" href="/otazky">Na co se lidé ptají</a>
        <a class="btn-quiet" href="/cenik">Cel&yacute; cen&iacute;k <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></a>
      </div>
    </div>
  </section>

  
  <Fragment slot="tail">
  <script src="/assets/js/glassfold.js" defer></script>
  <script src="/assets/js/chatdemo.js" defer></script>
  </Fragment>

</Base>
