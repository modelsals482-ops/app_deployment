    <div class="hero-anim">
      <div class="alsc-phone">
        <div class="alsc-top"><span class="alsc-av">K</span><div><div class="alsc-name">Klára</div><div class="alsc-status"><i></i>AI asistent · online</div></div></div>
        <div class="alsc-body" id="alsc-body"></div>
      </div>
    </div>
    <script is:inline>
    (function(){
      var CONVOS=[
        [["user","Dobrý den, můžu se objednat na příští týden?"],["bot","Jistě! Mám volno v úterý v 10:00 nebo ve středu ve 14:00. Co vám vyhovuje?"],["user","Úterý 10:00 prosím 🙂"],["bot","Hotovo ✅ Potvrzení jsem poslala e-mailem. Den předem přijde připomínka."]],
        [["user","Kolik stojí dámský střih?"],["bot","Dámský střih od 450 Kč, pánský od 300 Kč. Chcete rovnou najít termín?"],["user","Jasně, tento pátek?"],["bot","V pátek můžu v 16:00. Mám vás zapsat?"]],
        [["user","Máte volno v sobotu?"],["bot","V sobotu je bohužel plno. Nabízím pátek 16:00 nebo pondělí 9:00 — sedne vám něco?"]],
        [["user","Potřebuju zrušit zítřejší termín."],["bot","Zrušeno ✅ Kdykoli budete chtít nový termín, stačí napsat. 🙂"]],
        [["user","Ahoj, děláte i barvení?"],["bot","Ano! Barvení od 800 Kč včetně střihu. Můžu vás objednat?"],["user","Super, příští týden"],["bot","Mám volno ve čtvrtek v 11:00. Zapíšu vás?"]]
      ];
      var body=document.getElementById("alsc-body"), host=document.querySelector(".hero-anim");
      if(!body||!host) return;
      var timers=[], running=false, order=[];
      function wait(ms){ return new Promise(function(r){ timers.push(setTimeout(r,ms)); }); }
      function clearTimers(){ timers.forEach(clearTimeout); timers=[]; }
      function shuffle(){ order=CONVOS.map(function(_,i){return i;}); for(var i=order.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=order[i];order[i]=order[j];order[j]=t;} }
      function add(cls,text){ var d=document.createElement("div"); d.className="alsc-msg "+cls; d.textContent=text; body.appendChild(d); if(body.children.length>5) body.removeChild(body.firstChild); }
      function typing(){ var d=document.createElement("div"); d.className="alsc-typing"; d.innerHTML="<span></span><span></span><span></span>"; body.appendChild(d); return d; }
      async function play(){
        running=true; var idx=0; if(!order.length) shuffle();
        while(running){
          var convo=CONVOS[order[idx]]; body.innerHTML="";
          for(var m=0;m<convo.length && running;m++){
            var who=convo[m][0], text=convo[m][1];
            if(who==="bot"){ var t=typing(); await wait(650+Math.min(text.length*14,900)); if(!running)return; t.remove(); }
            else { await wait(m===0?200:500); if(!running)return; }
            add(who==="user"?"alsc-user":"alsc-bot", text);
            await wait(who==="bot"?1300:700); if(!running)return;
          }
          await wait(1600); if(!running)return;
          idx=(idx+1)%order.length; if(idx===0) shuffle();
        }
      }
      function start(){ if(running)return; running=true; play(); }
      function stop(){ running=false; clearTimers(); }
      if("IntersectionObserver" in window){
        new IntersectionObserver(function(es){ es.forEach(function(e){ e.isIntersecting && !document.hidden ? start() : stop(); }); },{threshold:.25}).observe(host);
      } else { start(); }
      document.addEventListener("visibilitychange", function(){ document.hidden ? stop() : start(); });
    })();
    </script>
