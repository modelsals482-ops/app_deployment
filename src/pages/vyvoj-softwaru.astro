  </div>

  <section class="hero-plain">
    <canvas class="scene scene-right" data-scene="halftone" aria-hidden="true"></canvas>
    <div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i></div>
    <div class="wrap">
      <span class="eyebrow-label">V&yacute;voj softwaru na m&iacute;ru</span>
      <h1 class="h-hero fade-head reveal-words" style="max-width:15ch">N&aacute;stroj m&iacute;sto <span class="grad">tabulky</span></h1>
      <p class="lead">Administra&ccaron;n&iacute; panely, napojen&iacute; syst&eacute;m&uring;, kter&eacute; spolu nemluv&iacute;, a intern&iacute; n&aacute;stroje m&iacute;sto tabulek p&rcaron;eposílan&yacute;ch e-mailem. Nasazen&iacute; v &rcaron;&aacute;du t&yacute;dn&uring;, ne m&ecaron;s&iacute;c&uring;.</p>
      <div class="btn-row">
        <a class="btn btn-grad btn-fill" href="/kontakt">Chci anal&yacute;zu zdarma</a>
        <a class="btn btn-trace" href="#priklad">Konkr&eacute;tn&iacute; p&rcaron;&iacute;klad</a>
      </div>
      <div class="price-line" style="margin-top:3.5rem">
        <div><div class="k">Cena za n&aacute;stroj</div><div class="v">od <span class="todo">doplnit</span> K&ccaron;</div></div>
        <div><div class="k">Provoz</div><div class="v">m&ecaron;s&iacute;&ccaron;n&iacute; pau&scaron;&aacute;l</div></div>
        <div><div class="k">Odpov&iacute;m do</div><div class="v">48 hodin</div></div>
        <div><div class="k">&Uacute;vodn&iacute; anal&yacute;za</div><div class="v">zdarma</div></div>
