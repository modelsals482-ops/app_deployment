  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Vývoj softwaru na míru",
      "serviceType": "Interní nástroje, administrační rozhraní a napojení systémů",
      "description": "Menší software na míru: administrační panely nad daty, která firma už má, napojení systémů, které spolu nemluví, a nástroje nahrazující ruční práci v tabulkách. Pevná cena za dohodnutý rozsah.",
      "url": "https://alsflow.cz/vyvoj-softwaru",
      "areaServed": [
        "CZ",
        "SK"
      ],
      "inLanguage": "cs",
      "provider": {
        "@type": "Organization",
        "name": "ALSflow",
        "legalName": "Retail Shops s.r.o.",
        "url": "https://alsflow.cz",
        "email": "info@alsflow.cz"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Jak velk&eacute; zak&aacute;zky berete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nástroje, které zvládne jeden vývojář nasadit v řádu týdnů, ne měsíců — administrační panel, napojení dvou systémů, nástroj, který nahradí ruční přepisování do tabulky. Na bankovní systém nebo aplikaci pro sto tisíc uživatelů nejsme ti správní a řekneme to hned na začátku."
          }
        },
        {
          "@type": "Question",
          "name": "Mus&iacute;me kv&uring;li tomu m&ecaron;nit syst&eacute;m, kter&yacute; pou&zcaron;&iacute;v&aacute;me?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ne. Skoro vždycky stavíme vedle toho, co už máte, a napojujeme se přes API nebo export. Migrace celého systému je nejdražší a nejrizikovější varianta a navrhujeme ji jen tehdy, když opravdu není jiná cesta."
          }
        },
        {
          "@type": "Question",
          "name": "Kdy uvid&iacute;me prvn&iacute; v&yacute;sledek?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nejdřív stavíme tu část, která odstraní největší ruční práci, a tu používáte dřív, než je hotové všechno ostatní. Podle toho, co v provozu vyjde najevo, pak upravujeme zbytek — je to levnější než dodat po půl roce něco, co se ukáže jako vedle."
          }
        },
        {
          "@type": "Question",
          "name": "Co kdy&zcaron; v&aacute;s budeme pot&rcaron;ebovat i za rok?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Provoz a další úpravy jsou měsíční paušál podle toho, jak velký nástroj je. Když se rozhodnete pokračovat sami, dostanete zdrojový kód, přístupy i dokumentaci — nedržíme si nic, čím bychom vás nutili zůstat."
          }
        },
        {
          "@type": "Question",
          "name": "Kde data pob&ecaron;&zcaron;&iacute;?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Na infrastruktuře vedené na vaše jméno, v Evropské unii. Zpracováváme jen údaje nutné k tomu, aby nástroj fungoval, a k zakázce podepisujeme zpracovatelskou smlouvu podle čl. 28 GDPR."
          }
        }
      ]
    }
  ]
}
