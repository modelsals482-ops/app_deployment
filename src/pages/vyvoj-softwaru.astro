---
import Base from "../layouts/Base.astro";
import Zigzag from "../components/Zigzag.astro";
import Showcase from "../components/Showcase.astro";
---
<Base
  title="Vývoj softwaru na míru: admin panely a integrace | ALSflow"
  description="Menší software na míru: administrační panely, propojení systémů, které spolu dnes nekomunikují, a interní nástroje místo tabulek. Nasazení v týdnech."
  canonical="https://alsflow.cz/vyvoj-softwaru"
  ogDescription="Admin panely, integrace a interní nástroje. Nasazení v řádu týdnů."
  current="/vyvoj-softwaru"
>
  <Fragment slot="head">
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Vývoj softwaru na míru",
      "serviceType": "Interní nástroje, administrační rozhraní a napojení systémů",
      "description": "Menší software na míru: administrační panely nad daty, která firma už má, propojení systémů, které spolu dnes nekomunikují, a nástroje nahrazující ruční práci v tabulkách.",
      "url": "https://alsflow.cz/vyvoj-softwaru",
      "areaServed": [
        "CZ",
        "SK"
      ],
      "inLanguage": "cs",
      "provider": {
        "@type": "Organization",
        "name": "ALSflow",
        "legalName": "Jakub Ryvola",
  "taxID": "30112702",
        "url": "https://alsflow.cz",
        "email": "info@alsflow.cz"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Jak velk&eacute; zak&aacute;zky berete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nástroje, které zvládne jeden vývojář nasadit v řádu týdnů, ne měsíců: administrační panel, napojení dvou systémů, nástroj, který nahradí ruční přepisování do tabulky. Na bankovní systém nebo aplikaci pro sto tisíc uživatelů nejsem ten správný a řeknu to hned na začátku."
          }
        },
        {
          "@type": "Question",
          "name": "Mus&iacute;me kv&uring;li tomu m&ecaron;nit syst&eacute;m, kter&yacute; pou&zcaron;&iacute;v&aacute;me?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ne. Skoro vždycky stavím vedle toho, co už máte, a napojuji se přes API nebo export. Migrace celého systému je nejdražší a nejrizikovější varianta a navrhuji ji jen tehdy, když opravdu není jiná cesta."
          }
        },
        {
          "@type": "Question",
          "name": "Kdy uvid&iacute;me prvn&iacute; v&yacute;sledek?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nejdřív stavím tu část, která odstraní největší ruční práci, a tu používáte dřív, než je hotové všechno ostatní. Podle toho, co se v provozu ukáže, pak upravuji zbytek. Vyjde to levněji, než po půl roce dodat něco, co nesedí."
          }
        },
        {
          "@type": "Question",
          "name": "Co kdy&zcaron; v&aacute;s budeme pot&rcaron;ebovat i za rok?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Provoz a další úpravy jsou měsíční paušál podle toho, jak velký nástroj je. Když se rozhodnete pokračovat sami, dostanete zdrojový kód, přístupy i dokumentaci, nedržím si nic, čím bych vás nutil zůstat."
          }
        },
        {
          "@type": "Question",
          "name": "Kde data pob&ecaron;&zcaron;&iacute;?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "V Evropské unii, na infrastruktuře vedené na vaše jméno, nebo po dohodě na mém serveru v Česku. Zpracovávám jen údaje nutné k tomu, aby nástroj fungoval. Kde jde o osobní údaje, patří k zakázce zpracovatelská smlouva podle čl. 28 GDPR."
          }
        }
      ]
    }
  ]
}
  </script>
  <!-- úvodní loader - jediný zdroj je tenhle obal, samostatný soubor už neexistuje -->
<script>
  /* Běží co nejdřív, ještě před vykreslením obsahu - jinak by loader
     naskočil až na chvíli hotovou stránku a probliklo by to. */
  (function () {
    try {
      if (sessionStorage.getItem('als-seen')) return;
    } catch (e) {
      /* privátní okno nebo zakázané úložiště - loader prostě ukážeme */
    }
    document.documentElement.classList.add('als-loading');
  })();
</script>
  <link rel="stylesheet" href="/assets/css/showcase.css" />
  <link rel="stylesheet" href="/assets/css/autopilot.css" />
  <script src="/assets/js/autopilot.js" defer></script>
  </Fragment>

  <section class="hero-plain hero-move">
    <canvas data-glassfold aria-hidden="true"></canvas>
    <div class="wrap">
      <h1 class="h-hero fade-head reveal-words" style="max-width:15ch">N&aacute;stroj m&iacute;sto <span class="grad">tabulky</span></h1>
      <p class="lead">Panel nad vašimi daty a propojení systémů místo přepisování tabulek. Nasazení v řádu týdnů, ne měsíců.</p>
      <div class="btn-row">
        <a class="btn btn-grad btn-fill" href="/kontakt">Chci anal&yacute;zu zdarma</a>
        <a class="btn btn-trace" href="#priklad">Konkr&eacute;tn&iacute; p&rcaron;&iacute;klad</a>
      </div>
      <div class="price-line" style="margin-top:3.5rem">
        <div><div class="k">Cena za n&aacute;stroj</div><div class="v">od 24&nbsp;900&nbsp;K&ccaron;</div></div>
        <div><div class="k">Provoz</div><div class="v">m&ecaron;s&iacute;&ccaron;n&iacute; pau&scaron;&aacute;l</div></div>
        <div><div class="k">Odpov&iacute;m do</div><div class="v">48 hodin</div></div>
        <div><div class="k">&Uacute;vodn&iacute; anal&yacute;za</div><div class="v">zdarma</div></div>
      </div>
    </div>
  </section>

  <section class="sec" id="co-udela">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Co software udělá <span class="grad">za vás</span></h2>
        <p class="lead">Zakázka skoro nikdy nezačne slovem „software“. Začne tím, že něco zdržuje nebo se v tom dělají chyby. Klikněte a podívejte se, jak to vypadá, když to dělá počítač.</p>
      </div>

      <div class="ap rev" data-ap>
        <div class="ap-tabs" role="tablist" aria-label="Co software udělá">
          <button class="ap-tab" role="tab" id="ap-t1" aria-controls="ap-p1" aria-selected="true" style="--c: var(--cyan)"><b>Panel nad vlastními daty</b><span>Tým spravuje katalog, ceník nebo objednávky bez Excelu.</span><i class="ap-prog" aria-hidden="true"></i></button>
          <button class="ap-tab" role="tab" id="ap-t2" aria-controls="ap-p2" aria-selected="false" tabindex="-1" style="--c: var(--blue)"><b>Propojení systémů</b><span>Web, sklad a účetnictví si data předají samy.</span><i class="ap-prog" aria-hidden="true"></i></button>
          <button class="ap-tab" role="tab" id="ap-t3" aria-controls="ap-p3" aria-selected="false" tabindex="-1" style="--c: var(--violet)"><b>Konec ruční práce</b><span>Z e-mailu je za vteřinu vyplněný doklad.</span><i class="ap-prog" aria-hidden="true"></i></button>
          <button class="ap-tab" role="tab" id="ap-t4" aria-controls="ap-p4" aria-selected="false" tabindex="-1" style="--c: var(--green)"><b>Přehled, který sedí</b><span>Jedno místo s čísly místo pěti exportů.</span><i class="ap-prog" aria-hidden="true"></i></button>
        </div>

        <div class="ap-win">
          <div class="ap-bar" aria-hidden="true"><i></i><i></i><i></i><b>vas-nastroj.cz</b><span class="ap-tag">Ukázka</span></div>

          <div class="ap-panel is-on" role="tabpanel" id="ap-p1" aria-labelledby="ap-t1">
            <table class="ap-table">
              <thead><tr><th>Položka</th><th>Stav</th><th>Kusů</th></tr></thead>
              <tbody>
                <tr><td>Reproduktor 12"</td><td><span class="pill ok">Skladem</span></td><td>8</td></tr>
                <tr class="ap-hit"><td>LED stěna 3×2 m</td><td><span class="pill swap"><span>Půjčeno</span><span>Skladem</span></span></td><td><span class="num-swap"><span>0</span><span>4</span></span></td></tr>
                <tr><td>Mixážní pult</td><td><span class="pill ok">Skladem</span></td><td>3</td></tr>
                <tr><td>Světelný most</td><td><span class="pill out">Půjčeno</span></td><td>0</td></tr>
              </tbody>
            </table>
            <span class="ap-cursor" aria-hidden="true"></span>
            <span class="ap-toast">Uloženo. Web už ukazuje „Skladem“.</span>
          </div>

          <div class="ap-panel" role="tabpanel" id="ap-p2" aria-labelledby="ap-t2" hidden>
            <div class="ap-flow">
              <div class="node n1"><b>Web</b><span>Objednávka #1042</span></div>
              <div class="node n2"><b>Sklad</b><span>Odepsáno 2 ks</span></div>
              <div class="node n3"><b>Účetnictví</b><span>Faktura vystavena</span></div>
              <svg class="wires" viewBox="0 0 600 260" preserveAspectRatio="none" aria-hidden="true"><path d="M150 130 C 230 130, 230 60, 300 60"/><path d="M300 60 C 370 60, 370 200, 450 200"/></svg>
              <span class="packet p1" aria-hidden="true"></span><span class="packet p2" aria-hidden="true"></span>
            </div>
            <p class="ap-note">Nikdo nic nepřepisuje, nevznikají dvě verze pravdy.</p>
          </div>

          <div class="ap-panel" role="tabpanel" id="ap-p3" aria-labelledby="ap-t3" hidden>
            <div class="ap-mail">
              <div class="mail-card"><b>Poptávka z webu</b><span>Dobrý den, potřebuji 2× reproduktor a mixpult na 14. 11. Jana Nováková</span></div>
              <div class="mail-arrow" aria-hidden="true"></div>
              <dl class="mail-form">
                <div><dt>Zákazník</dt><dd><span class="type">Jana Nováková</span></dd></div>
                <div><dt>Položky</dt><dd><span class="type">2× reproduktor, 1× mixpult</span></dd></div>
                <div><dt>Termín</dt><dd><span class="type">14. 11. 2026</span></dd></div>
              </dl>
              <span class="mail-done">Doklad.pdf je hotový</span>
            </div>
          </div>

          <div class="ap-panel" role="tabpanel" id="ap-p4" aria-labelledby="ap-t4" hidden>
            <div class="ap-kpis">
              <div><span>Poptávky</span><b data-to="128">128</b></div>
              <div><span>Vyřízeno</span><b data-to="96" data-suf=" %">96 %</b></div>
              <div><span>Ušetřeno</span><b data-to="31" data-suf=" h">31 h</b></div>
            </div>
            <div class="ap-chart" aria-hidden="true">
              <i style="--h:38%"></i><i style="--h:52%"></i><i style="--h:47%"></i><i style="--h:66%"></i><i style="--h:71%"></i><i style="--h:88%"></i>
            </div>
            <p class="ap-note">Ukázková čísla.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Showcase id="priklad" side="r" color="blue" dark title="Katalog, který spravuje obsluha" who="We Love Production · rental techniky"
    main={{ src: "/assets/ref/wle-rental.webp", alt: "Katalog rentalu techniky na weloveproduction.cz", label: "weloveproduction.cz/rental" }}
    second={{ src: "/assets/ref/wle-cards.webp", alt: "Položky v katalogu s tlačítkem Do košíku", label: "rental/zvuk/reproduktory", w: 900, h: 400 }}
    bubbles={[
      { text: "346 položek", c: "blue", at: "top:-6%; left:14%", size: "7.2rem" },
      { text: "Dostupnost u položky", c: "cyan", at: "top:36%; left:-3%" },
      { text: "Bez zásahu vývojáře", c: "violet", at: "bottom:2%; right:20%", size: "7.6rem", ghost: true }
    ]}>
    <p>Dřív se dostupnost zjišťovala telefonem a v tabulce. Teď ji katalog ukazuje rovnou u položky a obsluha ho spravuje sama v administraci.</p>
    <ul class="proj-facts">
      <li>Nejmenší řešení, které problém opravdu vyřeší</li>
      <li>Napojím se na to, co už máte</li>
      <li>Kód, účty a dokumentace na vaše jméno</li>
      <li>Provoz v EU, se smlouvou podle čl. 28 GDPR</li>
    </ul>
    <span class="proj-pill">Veřejně brzy</span>
  </Showcase>

  <section class="sec sec-line">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Od probl&eacute;mu <span class="grad">a&zcaron; do provozu</span></h2>
      </div>
      <Zigzag steps={[
        { c: "cyan", t: "Popíšete, co vás zdržuje", p: "Nemusíte vědět, jestli chcete panel, propojení nebo skript. Stačí říct, kde ztrácíte čas a kde vznikají chyby.", get: "Nezávazný hovor na čtvrt hodiny" },
        { c: "blue", t: "Krátká analýza", p: "Podívám se, co už máte a co vaše systémy umí. Když se nástroj nevyplatí, řeknu to na rovinu.", get: "Návrh rozsahu, cenu a termín, zdarma" },
        { c: "violet", t: "První použitelná verze", p: "Nejdřív to, co ubere nejvíc ruční práce. Používáte ji dřív, než je hotové všechno ostatní.", get: "Fungující nástroj na odkazu" },
        { c: "green", t: "Nasazení a předání", p: "Zprovozním, zaškolím vás a předám všechny přístupy.", get: "Kód, účty a dokumentaci na vaše jméno" },
        { c: "amber", t: "Provoz", p: "Měsíční paušál za to, že to běží, aktualizuje se a máte komu napsat.", get: "Odpověď do 48 hodin v pracovní dny" },
      ]} />
      <script src="/assets/js/zigzag.js" defer is:inline></script>
      <div class="btn-row rev">
        <a class="btn btn-swap" href="/kontakt"><span class="lbl"><span>Pop&iacute;&scaron;u probl&eacute;m</span><span>Napi&scaron;te mi</span></span></a>
      </div>
      <p class="lead" style="margin-top:2.5rem">Co neberu: mobiln&iacute; aplikace do App Storu, syst&eacute;my pro stovky tis&iacute;c u&zcaron;ivatel&uring; a p&rcaron;evzet&iacute; ciz&iacute;ho projektu bez dokumentace. &Rcaron;eknu to hned na za&ccaron;&aacute;tku, ne po m&ecaron;s&iacute;ci.</p>
    </div>
  </section>

  <!-- Technické specifikace (16. 10.): bývalé "Pod kapotou", teď přímo pod
       katalogem, o kterém mluví. Bez IP adres, adres administrace a verzí
       softwaru: nic, co by pomohlo útočníkovi. -->
  <section class="sec sec-dark spec-sec" id="specifikace">
    <div class="wrap">
      <details class="spec rev">
        <summary><span class="hood-mono">&gt;_</span> Technické specifikace <span class="hood-sub">jak běží katalog rentalu na weloveproduction.cz</span></summary>
        <dl class="spec-grid">
            <div><dt>Web a katalog</dt><dd>Statický web (Astro) na Cloudflare Pages. 346 položek ve 48 kategoriích, dostupnost přímo u položky.</dd></div>
            <div><dt>Server</dt><dd>Node.js API v Dockeru na serveru v EU. HTTPS přes Caddy, před tím Cloudflare (firewall, ochrana proti útokům).</dd></div>
            <div><dt>Databáze</dt><dd>PostgreSQL. Všechny dotazy parametrizované, takže podstrčený text se nikdy nespustí jako příkaz.</dd></div>
            <div><dt>Přístup na server</dt><dd>Server přijme spojení jen přes Cloudflare. Přímo na adresu serveru se nikdo nedostane.</dd></div>
            <div><dt>Administrace</dt><dd>Přihlášení přes Cloudflare Access jen pro pozvané e-maily, záložně vlastní hesla (scrypt). Relace vyprší po 12 hodinách.</dd></div>
            <div><dt>Historie změn</dt><dd>Každá úprava se zapíše: kdo, kdy a co bylo před a po. Hesla ani klíče se do záznamu nikdy nedostanou.</dd></div>
            <div><dt>Poptávky z košíku</dt><dd>Odejdou e-mailem týmu, formulář chrání Cloudflare Turnstile. Odeslání se měří v Google Analytics.</dd></div>
            <div><dt>AI asistent Jack</dt><dd>Odpovídá zákazníkům nad stejným katalogem (Google Gemini). Vždy se představí jako AI.</dd></div>
            <div><dt>Zálohy</dt><dd>Databáze se zálohuje každý den ve 3:00, drží se 14 dní. Obnova ze zálohy je vyzkoušená.</dd></div>
            <div><dt>Testy</dt><dd>Automatické testy přihlášení a historie změn, včetně pokusů o SQL injection.</dd></div>
            <div><dt>Vlastnictví</dt><dd>Zdrojový kód, účty i dokumentace jsou na jméno klienta.</dd></div>
        </dl>
      </details>
    </div>
  </section>

  <section class="sec sec-line" id="otazky">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Na co se pt&aacute;te</h2>
      </div>
      <div class="faq">
        <details class="rev" data-d="0"><summary>Jak velk&eacute; zak&aacute;zky berete?</summary><p>Nástroje, které zvládne jeden vývojář nasadit v řádu týdnů, ne měsíců: administrační panel, napojení dvou systémů, nástroj, který nahradí ruční přepisování do tabulky. Na bankovní systém nebo aplikaci pro sto tisíc uživatelů nejsem ten správný a řeknu to hned na začátku.</p></details>
        <details class="rev" data-d="1"><summary>Mus&iacute;me kv&uring;li tomu m&ecaron;nit syst&eacute;m, kter&yacute; pou&zcaron;&iacute;v&aacute;me?</summary><p>Ne. Skoro vždycky stavím vedle toho, co už máte, a napojuji se přes API nebo export. Migrace celého systému je nejdražší a nejrizikovější varianta a navrhuji ji jen tehdy, když opravdu není jiná cesta.</p></details>
        <details class="rev" data-d="2"><summary>Kdy uvid&iacute;me prvn&iacute; v&yacute;sledek?</summary><p>Nejdřív stavím tu část, která odstraní největší ruční práci, a tu používáte dřív, než je hotové všechno ostatní. Podle toho, co se v provozu ukáže, pak upravuji zbytek. Vyjde to levněji, než po půl roce dodat něco, co nesedí.</p></details>
        <details class="rev" data-d="3"><summary>Co kdy&zcaron; v&aacute;s budeme pot&rcaron;ebovat i za rok?</summary><p>Provoz a další úpravy jsou měsíční paušál podle toho, jak velký nástroj je. Když se rozhodnete pokračovat sami, dostanete zdrojový kód, přístupy i dokumentaci, nedržím si nic, čím bych vás nutil zůstat.</p></details>
        <details class="rev" data-d="4"><summary>Kde data pob&ecaron;&zcaron;&iacute;?</summary><p>V Evropské unii, na infrastruktuře vedené na vaše jméno, nebo po dohodě na mém serveru v Česku. Zpracovávám jen údaje nutné k tomu, aby nástroj fungoval. Kde jde o osobní údaje, patří k zakázce zpracovatelská smlouva podle čl. 28 GDPR.</p></details>
      </div>
    </div>
  </section>

  <section class="closer">
    <div class="wrap">
      <h2 class="h-sec fade-head reveal-words">Zdr&zcaron;uje v&aacute;s n&ecaron;co, co by m&ecaron;l d&ecaron;lat po&ccaron;&iacute;ta&ccaron;?</h2>
      <p class="lead lead-center rev" data-d="1">Nez&aacute;vazn&yacute; hovor a kr&aacute;tk&aacute; anal&yacute;za. &Rcaron;eknu, jestli se to vyplat&iacute; &rcaron;e&scaron;it softwarem, a za kolik.</p>
      <div class="btn-row rev" data-d="2" style="justify-content:center">
        <a class="btn btn-grad btn-shine" href="/kontakt">Nez&aacute;vazn&aacute; nab&iacute;dka</a>
        <a class="btn-quiet" href="/tvorba-webu">Tvorba webu <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></a>
      </div>
    </div>
  </section>

  
<script src="/assets/js/glassfold.js" defer is:inline></script>
</Base>
