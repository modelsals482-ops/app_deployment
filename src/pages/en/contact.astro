---
// VYGENEROVÁNO z src/pages/kontakt.astro skriptem tools/i18n/make_en.py.
// Neupravovat ručně: změny patří do tools/i18n/en/kontakt.py.
import Base from "../../layouts/Base.astro";
---
<Base
  lang="en"
  title="Contact: get a free quote | ALSflow"
  description="Tell me what you need. Fill in a short form and I will reply within 48 hours. Websites, custom software and AI assistants. Based in Prague."
  canonical="https://alsflow.cz/en/contact"
  ogDescription="A short form and a reply within 48 hours. Websites, custom software and AI assistants."
  current="/en/contact"
  cta="#formular"
>
  <Fragment slot="head">
  <link rel="stylesheet" href="/assets/css/form.css" />
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "inLanguage": "en",
  "url": "https://alsflow.cz/en/contact",
  "mainEntity": {
    "@type": "ProfessionalService",
    "name": "ALSflow",
    "legalName": "Jakub Ryvola",
  "taxID": "30112702",
    "url": "https://alsflow.cz",
    "email": "info@alsflow.cz",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Předenická 684/17",
      "postalCode": "142 00",
      "addressLocality": "Prague 4",
      "addressCountry": "CZ"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "sales",
      "email": "ryvola@alsflow.cz",
      "areaServed": ["CZ", "SK"],
      "availableLanguage": ["cs", "sk", "en"]
    }
  }
}
  </script>
  <!-- úvodní loader - jediný zdroj je tenhle obal, samostatný soubor už neexistuje -->
<script>
  /* Běží co nejdřív, ještě před vykreslením obsahu - jinak by loader
     naskočil až na chvíli hotovou stránku a probliklo by to. */
  (function () {
    try {
      if (sessionStorage.getItem('als-seen')) return;
    } catch (e) {
      /* privátní okno nebo zakázané úložiště - loader prostě ukážeme */
    }
    document.documentElement.classList.add('als-loading');
  })();
</script>
  </Fragment>


  <section class="hero-plain kontakt-hero">
    <div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i></div>
    <!-- Svítící prstence z úvodní stránky (16. 10.): jen v pravé části
         hlavičky, text vlevo nepřekrývají. Na úzké obrazovce se schovají. -->
    <canvas id="arc3d" class="kontakt-arc" data-center aria-hidden="true"></canvas>
    <div class="wrap">
      <h1 class="h-hero fade-head reveal-words" style="max-width:15ch">Tell me what <span class="grad">you need</span></h1>
      <p class="lead">Fill in a few details. I will reply within 48 hours and we will go through what you need and how. If it turns out I am not the right person for it, I will say so straight away and will not try to sell you anything.</p>
    </div>
  </section>

  <section class="sec sec-line" id="formular">
    <div class="wrap">
      <div class="form-layout">
        <div>
          <div class="form-card" id="formCard">
            <div class="form-meter">
              <span class="bar" aria-hidden="true"><i></i></span>
              <span class="num" aria-live="polite">0 / 4</span>
            </div>

            <form id="poptavka" novalidate>
              <div class="form-grid">
                <div class="field">
            <input id="f-email" name="email" type="email" placeholder=" " required autocomplete="email" />
            <label for="f-email">Email<span class="req">*</span></label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please check the email address.</p>
          </div>
          <div class="field is-select">
            <select id="f-service" name="service" required>
            <option value="" disabled selected>Choose&hellip;</option>
            <option value="web">Website: new or redesigned</option>
            <option value="software">Custom software</option>
            <option value="ai">AI assistant</option>
            <option value="vice">Several things together</option>
            <option value="nevim">Not sure yet, I want advice</option>
            </select>
            <label for="f-service">What you need<span class="req">*</span></label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please choose one option.</p>
          </div>
                    <div class="field wide">
            <textarea id="f-msg" name="msg" placeholder=" " required></textarea>
            <label for="f-msg">How can I help?<span class="req">*</span></label>
            <p class="field-note">Please write at least one sentence.</p>
            <i class="line" aria-hidden="true"></i>
          </div>
          <div class="wide form-expand">
            <button type="button" class="btn-quiet form-more-btn" id="moreBtn" aria-expanded="false" aria-controls="formMore">
              <span data-more-open>I know exactly what I want: add details</span>
              <span data-more-close hidden>Hide details</span>
              <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
            </button>
          </div>
          <div class="form-more" id="formMore" hidden>
          <div class="field">
            <input id="f-name" name="name" type="text" placeholder=" " autocomplete="name" />
            <label for="f-name">Full name</label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please fill in this field.</p>
          </div>
                    <div class="field is-select">
            <select id="f-urgency" name="urgency">
            <option value="" disabled selected>Choose&hellip;</option>
            <option value="asap">As soon as possible, this week</option>
            <option value="this_month">This month</option>
            <option value="quarter">Within three months</option>
            <option value="exploring">Just looking around</option>
            </select>
            <label for="f-urgency">When do you want to start</label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please choose one option.</p>
          </div>
          <div class="field">
            <input id="f-phone" name="phone" type="tel" placeholder=" " autocomplete="tel" />
            <label for="f-phone">Phone</label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please fill in this field.</p>
          </div>
          <div class="field">
            <input id="f-city" name="city" type="text" placeholder=" " autocomplete="address-level2" />
            <label for="f-city">City</label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please fill in this field.</p>
          </div>
          <div class="field is-select">
            <select id="f-biz" name="biz">
            <option value="" disabled selected>Choose&hellip;</option>
            <option value="salon">Hair or beauty salon</option>
            <option value="vet">Vet</option>
            <option value="dental">Dental or medical practice</option>
            <option value="physio">Physio, wellness</option>
            <option value="shop">Shop, e-shop</option>
            <option value="services">Trades, services</option>
            <option value="freelancer">Freelancer, sole trader</option>
            <option value="small_firm">Small business, 2 to 10 people</option>
            <option value="other">Other</option>
            </select>
            <label for="f-biz">Industry</label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please choose one option.</p>
          </div>
          <div class="field is-select">
            <select id="f-size" name="size">
            <option value="" disabled selected>Choose&hellip;</option>
            <option value="solo">Just me</option>
            <option value="2-5">2 to 5 people</option>
            <option value="6-10">6 to 10 people</option>
            <option value="10+">More than 10</option>
            </select>
            <label for="f-size">Team size</label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please choose one option.</p>
          </div>
          <div class="field is-select">
            <select id="f-pain" name="pain">
            <option value="" disabled selected>Choose&hellip;</option>
            <option value="cas">I lose time on manual work</option>
            <option value="zmeskane">I cannot keep up with replies and lose jobs</option>
            <option value="web">My website is outdated, or I have none</option>
            <option value="systemy">My systems do not talk to each other, I retype data</option>
            <option value="tabulky">Everything runs in spreadsheets</option>
            <option value="jine">Other</option>
            </select>
            <label for="f-pain">What holds you back most</label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please choose one option.</p>
          </div>
          <div class="field is-select">
            <select id="f-pref" name="pref_time">
            <option value="kdykoliv" selected>Any time</option>
            <option value="rano">Morning, 9 to 11 (Prague time)</option>
            <option value="poledne">Midday, 11 to 13 (Prague time)</option>
            <option value="odpoledne">Afternoon, 13 to 17 (Prague time)</option>
            </select>
            <label for="f-pref">Best time to call you</label>
            <i class="line" aria-hidden="true"></i>
            <svg class="tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 8.5 3.5 3.5 7.5-8"/></svg>
            <p class="field-note">Please choose one option.</p>
          </div>
          <p class="form-legend">None of this is required. The more you fill in, the more specific the quote you get in my first reply.</p>
          </div>
                      </div>

              <label class="form-consent">
                <input type="checkbox" name="gdpr" required />
                <span>I agree to my details being processed to prepare a quote. Details in the <a href="/en/privacy">privacy policy</a>. I never sell them and I send no newsletter.</span>
              </label>

              <div class="hp" aria-hidden="true">
                <label for="f-website">Website</label>
                <input type="text" id="f-website" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <div class="cf-turnstile" data-sitekey="0x4AAAAAAD2dJqPN10PUmbD9" data-theme="dark" data-language="en" style="margin:1.4rem 0 0;display:flex;justify-content:center"></div>

              <button class="btn btn-grad btn-shine form-send" type="submit" id="send">Send enquiry</button>
              <p class="form-err" id="formErr" role="alert" hidden></p>
            </form>
          </div>

          <div class="form-done" id="formDone" role="status">
            <div class="ring">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle class="circ" cx="50" cy="50" r="46" />
                <path class="check" d="m31 51 13 13 25-27" />
              </svg>
            </div>
            <h2 class="h-sec fade-head">Got it.</h2>
            <p>Your enquiry has arrived. I will get back to you by email or phone within 48 hours on working days. If it is urgent, write directly to <a href="mailto:ryvola@alsflow.cz" style="color:var(--blue)">ryvola@alsflow.cz</a>.</p>
            <div class="btn-row">
              <a class="btn btn-magnet" href="/en">Back to the homepage</a>
              <a class="btn-quiet" href="/en/pricing">Full pricing <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></a>
            </div>
          </div>
        </div>

        <aside class="form-side">
          <div class="rev">
            <ol class="steps">
              <li><b>I get back to you</b>Within 48 hours on working days. A short fifteen-minute call about what you need.</li>
              <li><b>I propose a solution and a price</b>On its own, as a bundle, or custom. We agree the price together based on what you need and how much of it.</li>
              <li><b>We start</b>Once you approve. Until then it costs you nothing and you are not committed to anything.</li>
            </ol>
          </div>

          <div class="contact-card rev" data-d="1">
            <h3>Rather call or email directly?</h3>
            <a href="tel:+420770162346"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3.5 1.5h2.5l1.2 3-1.6 1.1a8 8 0 0 0 4.8 4.8l1.1-1.6 3 1.2v2.5a1.5 1.5 0 0 1-1.6 1.5A12.5 12.5 0 0 1 2 3.1 1.5 1.5 0 0 1 3.5 1.5Z"/></svg><span>+420 770 162 346<span class="who">Jakub Ryvola: straight to my phone</span></span></a>
            <a href="mailto:ryvola@alsflow.cz"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1.5" y="3.5" width="13" height="9" rx="1.5"/><path d="m2 4.5 6 4 6-4"/></svg><span>ryvola@alsflow.cz<span class="who">Jakub Ryvola: projects and quotes</span></span></a>
            <a href="mailto:info@alsflow.cz"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1.5" y="3.5" width="13" height="9" rx="1.5"/><path d="m2 4.5 6 4 6-4"/></svg><span>info@alsflow.cz<span class="who">Operations, invoices, support</span></span></a>
            <p class="addr">
              Jakub Ryvola<br />
              Předenická 684/17<br />
              142&nbsp;00 Prague 4, Czech Republic<br />
              Company ID (I&Ccaron;O) 30112702 &middot; not a VAT payer
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  
  <Fragment slot="tail">
  <script src="/assets/js/form.js" defer></script>
  <script src="/assets/js/arc3d.js" defer></script>
  <style>
    /* Prstence jen vpravo od textu: plátno začíná až za nadpisem a jeho
       levý okraj se ztrácí do tmy. */
    #arc3d.kontakt-arc { position: absolute; top: 0; right: -2%; left: auto; z-index: 0; width: 40%; height: 100%; pointer-events: none;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 45%); mask-image: linear-gradient(90deg, transparent, #000 45%); }
    .kontakt-hero .h-hero { font-size: clamp(2.6rem, 5vw, 4.6rem); }
    .kontakt-hero .lead { max-width: 34rem; }
    @media (max-width: 1100px) { #arc3d.kontakt-arc { display: none; } }
  </style>
  </Fragment>

</Base>
