---
// VYGENEROVÁNO z src/pages/o-nas.astro skriptem tools/i18n/make_en.py.
// Neupravovat ručně: změny patří do tools/i18n/en/o-nas.py.
import Base from "../../layouts/Base.astro";
---
<Base
  lang="en"
  title="About me: one person, three crafts | ALSflow"
  description="ALSflow is a one-person studio. Websites, custom software and AI assistants for small businesses; you deal with me, not a call centre. Based in Prague."
  canonical="https://alsflow.cz/en/about"
  ogDescription="A one-person studio. Websites, custom software and AI assistants for small businesses."
  current="/en/about"
>
  <Fragment slot="head">
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "inLanguage": "en",
  "url": "https://alsflow.cz/en/about",
  "mainEntity": {
    "@type": "ProfessionalService",
    "name": "ALSflow",
    "legalName": "Jakub Ryvola",
  "taxID": "30112702",
    "url": "https://alsflow.cz",
    "email": "info@alsflow.cz",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Předenická 684/17",
      "postalCode": "142 00",
      "addressLocality": "Prague 4",
      "addressCountry": "CZ"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "sales",
      "email": "ryvola@alsflow.cz",
      "areaServed": ["CZ", "SK"],
      "availableLanguage": ["cs", "sk", "en"]
    }
  }
}
  </script>
  <!-- úvodní loader - jediný zdroj je tenhle obal, samostatný soubor už neexistuje -->
<script>
  /* Běží co nejdřív, ještě před vykreslením obsahu - jinak by loader
     naskočil až na chvíli hotovou stránku a probliklo by to. */
  (function () {
    try {
      if (sessionStorage.getItem('als-seen')) return;
    } catch (e) {
      /* privátní okno nebo zakázané úložiště - loader prostě ukážeme */
    }
    document.documentElement.classList.add('als-loading');
  })();
</script>
  </Fragment>
<div class="isl-bg" aria-hidden="true"></div>
<main class="islands">
  <div class="isl-thread" aria-hidden="true"><i></i><b></b></div>
  <section class="hero-plain">
    <div class="wrap isl isl-from-l is-in">
      <span class="isl-bub" style="--bc: var(--cyan); bottom:-1.4rem; right:2.5rem">Reply within 48 hours</span>
      <h1 class="h-hero fade-head">Jakub Ryvola</h1>
      <p class="isl-role">I build <span class="rot" data-rot><span class="on" style="--rc: var(--cyan)">websites</span><span style="--rc: var(--blue)">custom software</span><span style="--rc: var(--violet)">AI assistants</span></span></p>
      <p class="lead">Founder of ALSflow, not an agency. A small business needs the same tools as a big one, just without an IT department and a three-year contract. That is why <strong>I set everything up personally and I am reachable when you need something.</strong></p>
      <div class="btn-row">
        <a class="btn btn-grad btn-magnet" href="/en/contact">Get a free quote</a>
        <a class="btn btn-quiet" href="/en/websites">See my work</a>
      </div>
      <dl class="isl-stats">
        <div><dt><span data-count="48">48</span>&nbsp;h</dt><dd>to reply on working days</dd></div>
        <div><dt><span data-count="15">15</span>&nbsp;min</dt><dd>first call, no obligation</dd></div>
        <div><dt><span data-count="3">3</span></dt><dd>crafts, one person</dd></div>
      </dl>
    </div>
  </section>

  <section class="sec">
    <div class="wrap isl isl-from-r">
      <span class="isl-bub" style="--bc: var(--violet); top:-1.8rem; left:2.5rem">It started with AI assistants</span>
      <div class="isl-split">
      <div class="sec-head">
        <h2 class="h-sec fade-head">How it <span class="grad">started</span></h2>
        <p class="lead">I saw for myself how owners of small businesses spend hours every day answering the same messages. A customer asks about the price, a free slot, where to park. Meanwhile you are busy with the work people come to you for.</p>
        <p style="margin-top:1rem;font-size:0.85rem;color:var(--t3)">ALSflow is run by me, <strong>Jakub Ryvola</strong>, Company ID (I&Ccaron;O) 30112702, registered at Předenická 684/17, 142 00 Prague 4, Czech Republic, a sole trader registered in the Czech Trade Register. Websites, software and AI assistants are all invoiced under this Company ID. I am not a VAT payer. With clients who work with customer data, I sign a data processing agreement under the GDPR. More in the <a href="/en/privacy">privacy policy</a>.</p>
      </div>
      <div class="isl-pings" aria-hidden="true">
        <span style="--i: 0">How much is it?</span>
        <span style="--i: 1">Are you free on Friday?</span>
        <span style="--i: 2">Where can I park?</span>
        <span style="--i: 3">Sorry, how much was it?</span>
        <em style="--i: 4">&hellip;and you are in the middle of work.</em>
      </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap isl isl-from-l">
      <span class="isl-bub" style="--bc: var(--green); top:-1.6rem; right:3rem">No commitment</span>
      <div class="sec-head">
        <h2 class="h-sec fade-head">The most expensive thing is <span class="grad">lost time</span></h2>
        <p class="lead">Answering the same messages again and again, retyping into spreadsheets, a website nobody has updated for two years. All of that can be solved so you have time left for the work you enjoy.</p>
      </div>
      <div class="cards-2">
        <div class="panel panel-pad panel-sheen tilt rev">
          <h3>Practical</h3>
          <p>No jargon. You tell me what slows you down and I tell you straight whether it is worth solving.</p>
        </div>
        <div class="panel panel-pad panel-sheen tilt rev" data-d="1">
          <h3>Priced by scope, not by template</h3>
          <p>On its own, as a bundle, or custom. We agree the price together once we know what you really need. If you come up with something extra, I tell you the price of that change up front.</p>
        </div>
        <div class="panel panel-pad panel-sheen tilt rev" data-d="2">
          <h3>In person</h3>
          <p>You deal with me, not a call centre. I set it up myself and reply within 48 hours on working days.</p>
        </div>
        <div class="panel panel-pad panel-sheen tilt rev" data-d="3">
          <h3>No commitment</h3>
          <p>Assistants are paid monthly and you can cancel any time. The domain, accounts and source code are always in your name.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="word-marq marquee" aria-hidden="true">
    <div class="marquee-track">
      <span style="--mc: var(--cyan)">Websites</span><span style="--mc: var(--blue)">Custom software</span><span style="--mc: var(--violet)">AI assistants</span><span style="--mc: var(--green)">In person</span><span style="--mc: var(--amber)">Price up front</span>
      <span style="--mc: var(--cyan)">Websites</span><span style="--mc: var(--blue)">Custom software</span><span style="--mc: var(--violet)">AI assistants</span><span style="--mc: var(--green)">In person</span><span style="--mc: var(--amber)">Price up front</span>
    </div>
  </div>

  <section class="sec">
    <div class="wrap isl isl-from-r">
      <span class="isl-bub" style="--bc: var(--blue); top:-1.8rem; left:3rem">Three crafts, one person</span>
      <div class="sec-head">
        <h2 class="h-sec fade-head">Websites, software and <span class="grad">AI assistants</span></h2>
        <p class="lead">It started with AI assistants. Over time, though, I found real satisfaction in building websites that work and are a pleasure to look at. And because it is all connected, software came next: whoever built the website knows how to connect another tool to it.</p>
      </div>
      <div class="cards-2">
        <a class="panel panel-pad panel-sheen tilt rev" href="/en/websites" style="--c: var(--cyan)">
          <h3>Websites</h3>
          <p>Hand-coded pages with no content management system. I build, deploy and keep looking after them. I also look after e-shops and add what you need to them.</p>
          <span class="isl-more">Learn more &rarr;</span>
        </a>
        <a class="panel panel-pad panel-sheen tilt rev" data-d="1" href="/en/software" style="--c: var(--blue)">
          <h3>Custom software</h3>
          <p>Admin panels, links between systems that do not talk to each other today, and tools instead of spreadsheets.</p>
          <span class="isl-more">Learn more &rarr;</span>
        </a>
        <a class="panel panel-pad panel-sheen tilt rev" data-d="2" href="/en/ai-assistants" style="--c: var(--violet)">
          <h3>AI assistants</h3>
          <p>The assistant writes in your tone. When it is not sure, it hands over to you rather than making something up.</p>
          <span class="isl-more">Learn more &rarr;</span>
        </a>
        <div class="panel panel-pad rev isl-not" data-d="3">
          <h3>What I do not do</h3>
          <p>Mobile apps for the App Store and systems for hundreds of thousands of users. I will say so at the start, not after a month.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap isl isl-from-l">
      <span class="isl-bub" style="--bc: var(--amber); top:-1.6rem; right:2.5rem">15 minutes, no obligation</span>
      <div class="sec-head">
        <h2 class="h-sec fade-head">We can <span class="grad">talk it through for free</span></h2>
        <p class="lead">Fifteen minutes. You tell me what slows you down the most and I tell you whether I can help. No pressure, no tech talk.</p>
        <div class="btn-row">
          <a class="btn btn-grad btn-magnet" href="/en/contact">Get a free quote</a>
          <a class="btn btn-quiet" href="/en/pricing">Full pricing</a>
        </div>
      </div>
    </div>
  </section>
</main>

<style>
  /* Pokus 15. 10.: ostrovy. Pozadí stojí, obsah se po něm posouvá jako
     samostatné ostrovy. Jen na téhle stránce. */
  .isl-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(42rem 30rem at 12% 18%, rgb(56 219 245 / 9%), transparent 70%),
      radial-gradient(40rem 32rem at 88% 78%, rgb(167 139 250 / 11%), transparent 70%),
      radial-gradient(rgb(255 255 255 / 7%) 1px, transparent 1.3px) 0 0 / 26px 26px,
      #040406; }
  .islands { position: relative; z-index: 1; padding: 7.5rem 0 3rem; }
  .islands > section { margin: 0 0 clamp(2.2rem, 6vw, 4.5rem); padding: 0 !important; overflow: visible !important; background: none !important; }
  .islands > section::before, .islands > section::after { display: none !important; }
  .islands > section > .wrap { position: relative; max-width: min(1060px, calc(100% - 2rem)); margin: 0 auto; padding: clamp(1.8rem, 4.5vw, 3.6rem);
    background: #0b0b0e; border: 1px solid var(--line-2); border-radius: 32px;
    box-shadow: 0 40px 90px rgb(0 0 0 / 62%), 0 2px 0 rgb(255 255 255 / 4%) inset; }
  .islands .sec-head { margin-bottom: 0; }
  .islands .sec-head + .cards-2 { margin-top: 2rem; }
  .islands .panel h3 { margin: 0 0 0.55rem; font-size: 1.1rem; letter-spacing: -0.02em; }
  .islands .panel p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--t2); }
  .islands a.panel { display: flex; flex-direction: column; }
  .islands a.panel h3::before { display: inline-block; width: 0.55rem; height: 0.55rem; margin-right: 0.55rem; vertical-align: 0.12em; content: ""; background: var(--c); border-radius: 50%; }
  .isl-more { margin-top: auto; padding-top: 1rem; font-size: 0.9rem; font-weight: 600; color: var(--c); }
  .isl-not { background: none; border-style: dashed; }
  .isl-not h3 { color: var(--t2); }
  /* Ostrov přijede ze své strany a bublina na jeho hraně jednou vyskočí.
     Jen posun a průhlednost, žádné rozmazání a žádný .rev na obalu:
     nadpisy uvnitř si slova odhalují samy a dvě animace přes sebe je
     rozbily (15. 10.). První ostrov (úvod) stojí od začátku. */
  .isl { transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s; }
  .isl-ready .isl-from-l:not(.is-in) { opacity: 0; transform: translate3d(-10vw, 0, 0); }
  .isl-ready .isl-from-r:not(.is-in) { opacity: 0; transform: translate3d(10vw, 0, 0); }
  .isl-bub { position: absolute; z-index: 2; padding: 0.7rem 1.05rem; font-size: 0.9rem; font-weight: 700; color: #05070d; background: var(--bc);
    border-radius: 11px; box-shadow: 0 16px 36px rgb(0 0 0 / 55%); transform: scale(0.7); opacity: 0;
    transition: transform 0.6s 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s 0.45s; }
  .isl.is-in .isl-bub { transform: rotate(-2deg); opacity: 1; }
  .isl-from-r.is-in .isl-bub { transform: rotate(2deg); }
  [data-vykon="minimalni"] .isl, [data-vykon="minimalni"] .isl-bub { opacity: 1 !important; transform: none !important; transition: none; }
  @media (prefers-reduced-motion: reduce) { .isl, .isl-bub { opacity: 1 !important; transform: none !important; transition: none; } }
  @media (min-width: 1100px) {
    .islands > section:nth-of-type(odd) > .wrap.is-in { transform: translateX(-4vw); }
    .islands > section:nth-of-type(even) > .wrap.is-in { transform: translateX(4vw); }
    .islands > section:nth-of-type(5) > .wrap { max-width: 880px; }
  }
  /* ---- Pohyb navíc (15. 10.): všechno jen transform a opacity, nic
     neběží pořád kromě pásu slov, a ten jede na kompozitoru. ---- */
  .islands > section { position: relative; z-index: 1; }

  /* Nit mezi ostrovy: plní se, jak člověk roluje. Je vidět jen v mezerách
     mezi ostrovy, takže je spojuje, ale nepřekáží textu. */
  .isl-thread { position: absolute; top: 9rem; bottom: 6rem; left: 50%; z-index: 0; width: 2px; margin-left: -1px; background: rgb(255 255 255 / 6%); }
  .isl-thread i { position: absolute; inset: 0; background: linear-gradient(var(--cyan), var(--blue) 35%, var(--violet) 65%, var(--amber)); transform: scaleY(var(--p, 0)); transform-origin: top; }
  .isl-thread b { position: absolute; top: -5px; left: -4px; width: 10px; height: 10px; background: #fff; border-radius: 50%; box-shadow: 0 0 14px 4px rgb(91 157 255 / 70%); transform: translateY(var(--y, 0)); }

  .isl-role { margin: 0 0 1.4rem; font-size: clamp(1.25rem, 2.6vw, 1.9rem); font-weight: 700; letter-spacing: -0.02em; color: var(--t2); }
  .rot { display: inline-grid; vertical-align: top; }
  .rot > span { grid-area: 1 / 1; color: var(--rc); opacity: 0; transform: translateY(0.45em); transition: opacity 0.45s, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .rot > span.on { opacity: 1; transform: none; }
  .rot > span.off { transform: translateY(-0.45em); }

  .isl-stats { display: flex; flex-wrap: wrap; gap: 1.2rem 2.6rem; margin: 2.2rem 0 0; padding-top: 1.6rem; border-top: 1px solid var(--line-2); }
  .isl-stats div { min-width: 8rem; }
  .isl-stats dt { font-size: clamp(1.9rem, 3.6vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .isl-stats dd { margin: 0.45rem 0 0; font-size: 0.85rem; color: var(--t3); }

  .isl-split { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .isl-pings { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .isl-pings span, .isl-pings em { padding: 0.65rem 0.95rem; font-size: 0.92rem; font-style: normal; border-radius: 14px 14px 14px 4px;
    opacity: 0; transform: translateY(14px) scale(0.92); transform-origin: left bottom;
    transition: opacity 0.4s calc(0.5s + var(--i) * 0.45s), transform 0.6s calc(0.5s + var(--i) * 0.45s) cubic-bezier(0.16, 1, 0.3, 1); }
  .isl-pings span { color: var(--t1); background: rgb(255 255 255 / 7%); border: 1px solid var(--line-2); }
  .isl-pings span:nth-child(even) { margin-left: 1.4rem; }
  .isl-pings em { margin-top: 0.4rem; font-weight: 700; color: #05070d; background: var(--violet); border-radius: 11px; }
  .isl.is-in .isl-pings span, .isl.is-in .isl-pings em { opacity: 1; transform: none; }
  .isl.is-in .isl-pings em { transform: rotate(-2deg); }

  [data-vykon="minimalni"] .isl-pings > *, [data-vykon="minimalni"] .rot > span.on { opacity: 1 !important; transform: none !important; }
  @media (prefers-reduced-motion: reduce) { .isl-pings > * { opacity: 1 !important; transform: none !important; } }
  @media (max-width: 860px) {
    .isl-split { grid-template-columns: 1fr; }
    .isl-thread { display: none; }
  }
  /* Telefon (16. 10.): ostrovy byly moc velké a bubliny na hranách
     sousedních ostrovů do sebe narážely. Tady je bublina štítek nahoře
     v ostrově, ne volně na hraně, a všechno je o stupeň menší. */
  @media (max-width: 640px) {
    .islands { padding-top: 6rem; }
    .islands > section { margin-bottom: 2.4rem; }
    .islands > section > .wrap { padding: 1.4rem 1.15rem 1.5rem; border-radius: 22px; }
    .isl-bub { position: relative; inset: auto !important; display: inline-block; margin: 0 0 0.9rem; font-size: 0.78rem; padding: 0.45rem 0.75rem; }
    .islands .h-hero { font-size: 2.5rem; }
    .islands .h-sec { font-size: 1.85rem; }
    .islands .lead { font-size: 1rem; line-height: 1.6; }
    .isl-role { margin-bottom: 1rem; font-size: 1.15rem; }
    .islands .btn-row { margin-top: 1.2rem; }
    .isl-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin-top: 1.5rem; padding-top: 1.1rem; }
    .isl-stats div { min-width: 0; }
    .isl-stats dt { font-size: 1.55rem; }
    .isl-stats dd { font-size: 0.72rem; line-height: 1.35; }
    .islands .sec-head p[style] { font-size: 0.76rem !important; }
    .isl-split { gap: 1.2rem; }
    .isl-pings span, .isl-pings em { padding: 0.5rem 0.8rem; font-size: 0.84rem; }
    .islands .sec-head + .cards-2 { margin-top: 1.3rem; }
    .islands .cards-2 { gap: 0.7rem; }
    .islands .panel-pad { padding: 1.05rem 1.1rem; }
    .islands .panel h3 { font-size: 1rem; }
    .islands .panel p { font-size: 0.88rem; }
  }
</style>
<script>
  /* Ostrovy: přidá .is-in, když ostrov vjede do obrazu. Bez skriptu
     (nebo bez IntersectionObserver) jsou vidět hned. */
  (function () {
    var isl = document.querySelectorAll(".isl:not(.is-in)");
    document.documentElement.classList.add("isl-ready");
    if (!("IntersectionObserver" in window)) { isl.forEach(function (e) { e.classList.add("is-in"); }); return; }
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    isl.forEach(function (e) { io.observe(e); });
  })();

  /* Rotující řemeslo pod jménem a nit mezi ostrovy. Při omezeném pohybu
     nebo v minimálním stupni stojí: zůstane první slovo a prázdná nit. */
  (function () {
    var d = document.documentElement;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || d.getAttribute("data-vykon") === "minimalni") return;

    var rot = document.querySelector("[data-rot]");
    if (rot) {
      var words = rot.children, i = 0;
      setInterval(function () {
        if (document.hidden || window.scrollY > window.innerHeight) return;   /* mimo obraz nic nedělat */
        var cur = words[i], next = words[(i + 1) % words.length];
        cur.classList.remove("on"); cur.classList.add("off");
        next.classList.remove("off"); next.classList.add("on");
        i = (i + 1) % words.length;
      }, 2400);
    }

    var main = document.querySelector(".islands"), thread = document.querySelector(".isl-thread");
    if (!main || !thread) return;
    var top = 0, h = 1, queued = false;
    function measure() { var r = thread.getBoundingClientRect(); top = r.top + window.scrollY; h = Math.max(1, r.height); }
    function sync() {
      queued = false;
      var p = Math.min(1, Math.max(0, (window.scrollY + window.innerHeight * 0.55 - top) / h));
      thread.style.setProperty("--p", p.toFixed(4));
      thread.style.setProperty("--y", (p * h).toFixed(1) + "px");
    }
    measure(); sync();
    if ("ResizeObserver" in window) new ResizeObserver(function () { measure(); sync(); }).observe(main);
    window.addEventListener("scroll", function () { if (!queued) { queued = true; requestAnimationFrame(sync); } }, { passive: true });
  })();
</script>
</Base>
