---
import Base from "../layouts/Base.astro";
import Zigzag from "../components/Zigzag.astro";
import Showcase from "../components/Showcase.astro";
---
<Base
  title="Tvorba webových stránek: rychlý web bez WordPressu | ALSflow"
  description="Ručně psané weby bez redakčního systému a bez pluginů, které je potřeba aktualizovat. Návrh, texty, nasazení, doména i průběžná správa. Praha."
  canonical="https://alsflow.cz/tvorba-webu"
  ogDescription="Ručně psaný web bez WordPressu, živý do 6 až 10 pracovních dnů."
  current="/tvorba-webu"
>
  <Fragment slot="head">
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Tvorba webových stránek",
      "serviceType": "Návrh, vývoj a průběžná správa webových prezentací",
      "description": "Ručně psané weby bez redakčního systému a bez pluginů, které je potřeba aktualizovat. Návrh, texty, nasazení, doména i průběžná správa.",
      "url": "https://alsflow.cz/tvorba-webu",
      "areaServed": [
        "CZ",
        "SK"
      ],
      "inLanguage": "cs",
      "provider": {
        "@type": "Organization",
        "name": "ALSflow",
        "legalName": "Jakub Ryvola",
  "taxID": "30112702",
        "url": "https://alsflow.cz",
        "email": "info@alsflow.cz"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Budu si moci obsah upravovat s&aacute;m?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Drobné úpravy textů, cen a kontaktů dělám já a jsou v paušálu: napíšete e-mail a změnu udělám do 2 pracovních dnů. Pokud potřebujete měnit obsah několikrát týdně, řeknu to dopředu a navrhnu řešení s vlastním rozhraním."
          }
        },
        {
          "@type": "Question",
          "name": "Pro&ccaron; ne WordPress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ne kvůli ideologii. WordPress znamená jádro, šablonu a pluginy, které je potřeba pravidelně aktualizovat, a každá aktualizace může web rozbít. Tuhle vrstvu prostě nemám, takže za ni ani neplatíte."
          }
        },
        {
          "@type": "Question",
          "name": "Uvidím, co mi web přináší?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ano. Nasadím měření návštěvnosti, takže uvidíte, kolik lidí web navštívilo, odkud přišli a kolik z nich kliklo na telefon, e-mail nebo formulář. Měření ukládá cookies, proto k němu patří i lišta se souhlasem podle § 89 odst. 3 zákona č. 127/2005 Sb."
          }
        },
        {
          "@type": "Question",
          "name": "Komu web pat&rcaron;&iacute;?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vám. Doménu i účty vedu na vaše jméno a zdrojový kód dostanete celý. Kdybyste se se mnou rozloučili, web běží dál a převzít ho může kdokoli, kdo umí HTML."
          }
        }
      ]
    }
  ]
}
  </script>
  <!-- úvodní loader - jediný zdroj je tenhle obal, samostatný soubor už neexistuje -->
<script>
  /* Běží co nejdřív, ještě před vykreslením obsahu - jinak by loader
     naskočil až na chvíli hotovou stránku a probliklo by to. */
  (function () {
    try {
      if (sessionStorage.getItem('als-seen')) return;
    } catch (e) {
      /* privátní okno nebo zakázané úložiště - loader prostě ukážeme */
    }
    document.documentElement.classList.add('als-loading');
  })();
</script>
  <link rel="stylesheet" href="/assets/css/showcase.css" />
  </Fragment>

  <section class="hero-plain">
    <div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i></div>
    <div class="wrap">
      <h1 class="h-hero fade-head reveal-words" style="max-width:14ch">Web, kter&yacute; <span class="grad">nezest&aacute;rne</span></h1>
      <p class="lead">Ru&ccaron;n&ecaron; psan&eacute; str&aacute;nky bez redak&ccaron;n&iacute;ho syst&eacute;mu a bez plugin&uring;, kter&eacute; je pot&rcaron;eba aktualizovat. Postavím, nasadím a dál se starám. Vy se o techniku nestar&aacute;te v&uring;bec.</p>
      <div class="btn-row">
        <a class="btn btn-grad btn-magnet" href="/kontakt">Chci nab&iacute;dku</a>
        <a class="btn btn-trace" href="#reference">Podívat se na weby</a>
      </div>
      <div class="price-line" style="margin-top:3.5rem">
        <div><div class="k">Cena za web</div><div class="v">od 14&nbsp;900&nbsp;K&ccaron;</div></div>
        <div><div class="k">M&ecaron;s&iacute;&ccaron;n&iacute; spr&aacute;va</div><div class="v">990&nbsp;K&ccaron;</div></div>
        <div><div class="k">Odpov&iacute;m do</div><div class="v">48 hodin</div></div>
        <div><div class="k">Web &zcaron;iv&yacute; do</div><div class="v">6&ndash;10 prac. dn&iacute;</div></div>
      </div>
    </div>
  </section>

  <section class="sec" id="reference" style="padding-bottom:0">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Dva weby, jedna <span class="grad">sestava</span></h2>
        <p class="lead">Oba postavené stejně, oba dál spravuji. Prokliknout se dá obojí, jsou živé.</p>
      </div>
    </div>
  </section>

  <Showcase id="ref-gen" side="l" color="violet" title="gen1.cz" who="Politické hnutí · Praha 1"
    main={{ src: "/assets/ref/gen1-desktop.jpg", alt: "Úvodní stránka webu gen1.cz", label: "gen1.cz", w: 1080, h: 675 }}
    second={{ src: "/assets/ref/gen1-program.webp", alt: "Stránka s programem na gen1.cz", label: "gen1.cz/program" }}
    phone={{ src: "/assets/ref/gen1-m.webp", alt: "gen1.cz na mobilu" }}
    bubbles={[
      { text: "Aktuality si píšou sami", c: "violet", at: "top:-6%; right:14%" },
      { text: "Bez WordPressu", c: "cyan", at: "top:30%; right:-3%", size: "7rem" },
      { text: "Rychlý i na mobilu", c: "violet", at: "bottom:4%; left:30%", size: "7.4rem", ghost: true }
    ]}>
    <p>Program, kandidátka a přihláška do hnutí. Aktuality si hnutí píše samo, bez redakčního systému. Součástí je i povinné označení volební agitace.</p>
    <div class="btn-row"><a class="btn btn-svc" href="https://gen1.cz" target="_blank" rel="noopener">Otevřít gen1.cz</a></div>
  </Showcase>

  <Showcase id="ref-sekelova" side="r" color="amber" title="znalecsekelova.sk" who="Soudní znalkyně · Slovensko"
    main={{ src: "/assets/ref/sekelova-desktop.jpg", alt: "Úvodní stránka webu znalecsekelova.sk", label: "znalecsekelova.sk", w: 1080, h: 675 }}
    second={{ src: "/assets/ref/sek-cennik.webp", alt: "Ceník na znalecsekelova.sk", label: "znalecsekelova.sk/cennik" }}
    phone={{ src: "/assets/ref/sek-m.webp", alt: "znalecsekelova.sk na mobilu" }}
    bubbles={[
      { text: "Slovensky", c: "amber", at: "top:-5%; left:12%", size: "7rem" },
      { text: "Vlastní kresby v SVG", c: "cyan", at: "top:30%; left:-3%" },
      { text: "Plynulé rolování", c: "amber", at: "bottom:6%; right:30%", size: "7rem", ghost: true }
    ]}>
    <p>Osm stránek slovensky: služby, ceník, podklady k obhlídce. Kresby jsou vlastní, dělané přímo v SVG.</p>
    <div class="btn-row"><a class="btn btn-svc" href="https://znalecsekelova.sk" target="_blank" rel="noopener">Otevřít znalecsekelova.sk</a></div>
  </Showcase>

  <section class="sec sec-dark sec-line">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Co můžete <span class="grad">očekávat</span></h2>
        <p class="lead">Každý web stavím stejným postupem. Tohle dostanete vždycky, ať je web malý, nebo velký.</p>
      </div>
      <ol class="cascade">
        <li class="cas rev" style="--c: var(--cyan); --i: 0">
          <div class="cas-art cas-speed" aria-hidden="true"><span>Načteno</span><i></i></div>
          <div><h3>Rychlý i na mobilních datech</h3><p>Čisté HTML, CSS a JavaScript, žádné těžké šablony. Stránka naběhne dřív, než zákazník ztratí trpělivost.</p></div>
        </li>
        <li class="cas rev" data-d="1" style="--c: var(--blue); --i: 1">
          <div class="cas-art cas-plug" aria-hidden="true"><span>Pluginy</span><b>0</b></div>
          <div><h3>Nic, co by bylo potřeba aktualizovat</h3><p>Žádný redakční systém a žádné pluginy, které se při aktualizaci rozbijí. Web poběží i za dva roky.</p></div>
        </li>
        <li class="cas rev" data-d="2" style="--c: var(--violet); --i: 2">
          <div class="cas-art cas-mail" aria-hidden="true"><span>Formulář</span><em>&rarr;</em><span>E-mail</span></div>
          <div><h3>Žádná data navíc</h3><p>Formuláře pošlou e-mail a nic neukládají do databáze. Čím míň osobních údajů web drží, tím míň je co chránit.</p></div>
        </li>
        <li class="cas rev" data-d="3" style="--c: var(--green); --i: 3">
          <div class="cas-art cas-aa" aria-hidden="true"><b>Aa</b><span>kontrast změřen</span></div>
          <div><h3>Měřená přístupnost</h3><p>Kontrast každé dvojice text a pozadí počítám proti WCAG 2.2 AA. Na každém webu to zatím odhalilo skutečnou chybu.</p></div>
        </li>
        <li class="cas cas-report rev" data-d="4" style="--c: var(--amber); --i: 4">
          <div><h3>Jednou za měsíc přehled</h3><p>Kolik lidí přišlo na web, kolikrát vám zavolali a kolik poslali poptávek. Ať vidíte, co vám web přináší, a nemusíte to odhadovat.</p></div>
          <div class="panel report">
            <div class="report-top"><span><b>Měsíční přehled</b> · září</span><span class="pill">Ukázka</span></div>
            <ul class="report-rows">
              <li><span class="k">Návštěvy webu</span><span class="d">+18 %</span><span class="v" data-count="412">412</span></li>
              <li><span class="k">Kliknutí na telefon</span><span class="d">+6</span><span class="v" data-count="37">37</span></li>
              <li><span class="k">Poptávky z formuláře</span><span class="d">+3</span><span class="v" data-count="9">9</span></li>
            </ul>
            <p class="report-note">Ukázková čísla.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="sec sec-line">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Od hovoru k <span class="grad">&zcaron;iv&eacute;mu webu</span></h2>
      </div>
      <Zigzag steps={[
        { c: "cyan", t: "Úvodní hovor", p: "Čtvrt hodiny. Řeknete, komu má web sloužit a co po něm člověk má udělat. Z toho vyjde struktura stránek a cena.", get: "Strukturu webu a cenu předem" },
        { c: "blue", t: "Průběžný náhled", p: "Ještě než je web hotový, dostanete odkaz na rozpracovanou verzi. Fungující web, ne obrázek. Prokliknete ho na telefonu i na počítači.", get: "Odkaz, na kterém vidíte, jak web roste" },
        { c: "violet", t: "Texty a fotky", p: "Pokud texty nemáte, napíšu je já a vy je jen schválíte. Fotky dodáte, nebo je vyberu a ořížnu.", get: "Hotové texty ke schválení" },
        { c: "green", t: "Nasazení a doména", p: "Web spustím, nastavím DNS, certifikát a přesměrování. Vy neřešíte nic technického.", get: "Živý web na vaší doméně" },
        { c: "amber", t: "Správa", p: "Změna ceny, nová stránka, jiné otevírací hodiny. Napíšete e-mail, změním to. Do dvou pracovních dnů.", get: "Jednou za měsíc přehled návštěv a poptávek" },
      ]} />
      <script src="/assets/js/zigzag.js" defer is:inline></script>
      <div class="btn-row rev">
        <a class="btn btn-swap" href="/kontakt"><span class="lbl"><span>Chci nabídku</span><span>Napi&scaron;te mi</span></span></a>
      </div>
      <p class="lead" style="margin-top:2.5rem">Co nedělám: weby o stovkách stránek s denně přibývajícím obsahem. Kdy&zcaron; je to v&aacute;&scaron; p&rcaron;&iacute;pad, &rcaron;eknu to na prvn&iacute;m hovoru.</p>
    </div>
  </section>

  <section class="sec sec-line" id="otazky">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-sec fade-head reveal-words">Na co se pt&aacute;te</h2>
      </div>
      <div class="faq">
        <details class="rev" data-d="0"><summary>Jak rychle odpov&iacute;te?</summary><p>Na poptávku odpovídám do 48 hodin v pracovní dny a rovnou nabídnu termín hovoru. Během práce na webu i potom, když je potřeba něco změnit, je to stejné: platí ta samá lhůta.</p></details>
        <details class="rev" data-d="1"><summary>Budu si moci obsah upravovat s&aacute;m?</summary><p>Drobné úpravy textů, cen a kontaktů dělám já a jsou v paušálu: napíšete e-mail a změnu udělám do 2 pracovních dnů. Pokud potřebujete měnit obsah několikrát týdně, řeknu to dopředu a navrhnu řešení s vlastním rozhraním.</p></details>
        <details class="rev" data-d="2"><summary>Pro&ccaron; ne WordPress?</summary><p>Ne kvůli ideologii. WordPress znamená jádro, šablonu a pluginy, které je potřeba pravidelně aktualizovat, a každá aktualizace může web rozbít. Tuhle vrstvu prostě nemám, takže za ni ani neplatíte.</p></details>
        <details class="rev" data-d="3"><summary>Uvidím, co mi web přináší?</summary><p>Ano. Nasadím měření návštěvnosti, takže uvidíte, kolik lidí web navštívilo, odkud přišli a kolik z nich kliklo na telefon, e-mail nebo formulář. Měření ukládá cookies, proto k němu patří i lišta se souhlasem podle § 89 odst. 3 zákona č. 127/2005 Sb.</p></details>
        <details class="rev" data-d="4"><summary>Komu web pat&rcaron;&iacute;?</summary><p>Vám. Doménu i účty vedu na vaše jméno a zdrojový kód dostanete celý. Kdybyste se se mnou rozloučili, web běží dál a převzít ho může kdokoli, kdo umí HTML.</p></details>
      </div>
    </div>
  </section>

  <section class="closer">
    <div class="wrap">
      <h2 class="h-sec fade-head reveal-words">Potřebujete web už dlouho?</h2>
      <p class="lead lead-center rev" data-d="1">Řekněte, co potřebujete, a navrhnu řešení i cenu.</p>
      <div class="btn-row rev" data-d="2" style="justify-content:center">
        <a class="btn btn-grad btn-shine" href="/kontakt">Nez&aacute;vazn&aacute; nab&iacute;dka</a>
        <a class="btn-quiet" href="/vyvoj-softwaru">V&yacute;voj softwaru <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></a>
      </div>
    </div>
  </section>

  
</Base>
