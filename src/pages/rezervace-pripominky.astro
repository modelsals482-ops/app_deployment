---
import Base from "../layouts/Base.astro";
---
<Base
  title="Rezervace a připomínky | ALSflow"
  description="Asistent přijme rezervaci i večer, termín rovnou potvrdí a den předem ho připomene. 4 500 Kč měsíčně, bez závazku."
  canonical="https://alsflow.cz/rezervace-pripominky"
  ogTitle="Rezervace a připomínky"
  ogDescription="Diář se plní sám a zapomenuté termíny přestanou propadat. 4 500 Kč měsíčně."
  current="/ai-asistenti"
>
  <Fragment slot="head">
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Rezervace a připomínky",
  "serviceType": "Automatické objednávání termínů a připomínání pro malé firmy",
  "description": "Asistent přijme rezervaci přes WhatsApp nebo web i mimo otevírací dobu, termín potvrdí, zapíše do sdíleného kalendáře a den předem ho zákazníkovi připomene.",
  "areaServed": { "@type": "Country", "name": "Česká republika" },
  "provider": {
    "@type": "Organization",
    "name": "ALSflow",
    "legalName": "Retail Shops s.r.o.",
    "url": "https://alsflow.cz"
  },
  "offers": {
    "@type": "Offer",
    "price": "4500",
    "priceCurrency": "CZK",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "4500",
      "priceCurrency": "CZK",
      "unitCode": "MON"
    }
  }
}
  </script>
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Kolik stojí AI rezervace a připomínky?",
      "acceptedAnswer": { "@type": "Answer", "text": "4 500 Kč měsíčně, v ceně je 750 rezervací. Samostatně, nebo dohromady s e-mailovými odpověďmi a zpětnou vazbou za 7 500 Kč měsíčně. Jednorázové nastavení 8 až 10 000 Kč. Bez závazku, zrušíte kdykoli." }
    },
    {
      "@type": "Question",
      "name": "Potřebuji kvůli tomu nový rezervační systém?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ne. Asistent funguje s WhatsAppem, vaším webem nebo Google Kalendářem, které už máte, a umí běžet vedle stávajícího rezervačního systému, ne místo něj. Když žádný systém nemáte a vedete termíny na papíře nebo po telefonu, nastavíme vám ho celý." }
    },
    {
      "@type": "Question",
      "name": "Jak to snižuje počet nenastoupených termínů?",
      "acceptedAnswer": { "@type": "Answer", "text": "Připomínkou den předem, na kterou jde odpovědět a rovnou se přeobjednat. Termín se tak uvolní pro někoho jiného, místo aby propadl prázdný." }
    },
    {
      "@type": "Question",
      "name": "Bere rezervace i mimo otevírací dobu?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ano, nepřetržitě. Zákazník se objedná večer i o víkendu, aniž by musel telefonovat nebo čekat, až otevřete." }
    },
    {
      "@type": "Question",
      "name": "Jak dlouho trvá nastavení?",
      "acceptedAnswer": { "@type": "Answer", "text": "Do 5 až 7 pracovních dnů od úvodního patnáctiminutového hovoru. Napojení kalendáře, texty i testování řešíme my." }
    }
  ]
}
  </script>
  </Fragment>

  <section class="hero hero-plain">
    <canvas class="scene scene-right" data-scene="halftone" aria-hidden="true"></canvas>
    <div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i></div>
    <div class="wrap">
      <span class="eyebrow-label">AI asistent</span>
      <h1 class="h-hero fade-head reveal-words" style="max-width:16ch">Diář se plní sám. <span class="grad">A termíny přestanou propadat.</span></h1>
      <p class="lead">Zákazník se chce objednat večer, vy máte zavřeno. Někdo na termín zapomene
        a hodina propadne prázdná. Asistent přijme rezervaci kdykoli, termín rovnou potvrdí a den
        předem ho připomene.</p>
      <div class="btn-row">
        <a class="btn btn-grad btn-shine" href="/kontakt">Nezávazná nabídka</a>
        <a class="btn btn-quiet" href="/cenik">Ceník</a>
      </div>
    </div>
  </section>

  <!-- CO DELA -->
  <section class="sec sec-line scene-host" id="co-dela">
    <canvas class="scene scene-soft" data-scene="dotmatrix" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow-label">Co za vás udělá</span>
        <h2 class="h-sec fade-head reveal-words">Pět věcí kolem <span class="grad">jednoho termínu</span></h2>
        <p class="lead">Objednat člověka není jeden úkon. Je to pět drobností, a každá z nich stojí čas.</p>
      </div>

      <div class="rows">
        <div class="row rev"><span class="num">01</span><div><h3>Přijme rezervaci kdykoli</h3><p>Přes WhatsApp nebo váš web, i večer a o víkendu. Zákazník nemusí čekat, až otevřete.</p></div></div>
        <div class="row rev" data-d="1"><span class="num">02</span><div><h3>Hned potvrdí termín</h3><p>Zákazník ví, že má místo. Žádné „ozvu se vám" a žádné čekání, při kterém si to rozmyslí.</p></div></div>
        <div class="row rev" data-d="2"><span class="num">03</span><div><h3>Den předem připomene</h3><p>Zapomenutý termín je nejtišší ztráta, jakou máte. Nikdo si nestěžuje, jen nepřijde.</p></div></div>
        <div class="row rev" data-d="3"><span class="num">04</span><div><h3>Uvolní termín, když někdo nemůže</h3><p>Na připomínku jde odpovědět a přeobjednat se. Hodina se uvolní pro dalšího místo toho, aby propadla.</p></div></div>
        <div class="row rev" data-d="4"><span class="num">05</span><div><h3>Odpoví na dotazy kolem</h3><p>Ceny, dostupnost, jak to u vás probíhá. To dokola už neřešíte vy.</p></div></div>
      </div>
    </div>
  </section>

  <!-- MATE UZ SYSTEM -->
  <section class="sec sec-dark sec-line" id="proc">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow-label">Máte už rezervační systém?</span>
        <h2 class="h-sec fade-head reveal-words">Umíme běžet <span class="grad">vedle něj, ne místo něj</span></h2>
        <p class="lead">Tohle není další systém, na který byste museli přecházet, a nechceme, abyste
          kvůli nám opouštěli něco, co vám funguje. Když už rezervace nějak řešíte, asistent se napojí
          na WhatsApp, váš web nebo Google Kalendář a vezme na sebe to kolem: dotazy, potvrzení,
          připomínky. A když žádný systém nemáte a jedete papír nebo telefon, nastavíme vám ho celý.</p>
      </div>
    </div>
  </section>

  <!-- JAK TO PROBIHA -->
  <section class="sec sec-line" id="jak">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow-label">Jak to probíhá</span>
        <h2 class="h-sec fade-head reveal-words">Tři kroky, <span class="grad">nic technického</span></h2>
      </div>
      <div class="cards-3">
        <div class="panel panel-pad panel-glow rev">
          <h3>1. Patnáct minut hovoru</h3>
          <p>Jak k vám lidé chodí, na co se ptají a kde vedete termíny. Žádná technika.</p>
        </div>
        <div class="panel panel-pad panel-glow rev" data-d="1">
          <h3>2. Nastavíme to za vás</h3>
          <p>Do 5 až 7 pracovních dnů napojíme kalendář, nastavíme připomínky a otestujeme je.</p>
        </div>
        <div class="panel panel-pad panel-glow rev" data-d="2">
          <h3>3. Diář jede sám</h3>
          <p>Asistent objednává a připomíná od první minuty. Vy jen mrknete na měsíční přehled.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CENA -->
  <section class="sec sec-dark sec-line" id="cena">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow-label">Kolik to stojí</span>
        <h2 class="h-sec fade-head reveal-words">4 500 Kč měsíčně, <span class="grad">bez závazku</span></h2>
        <p class="lead">V ceně je 750 rezervací měsíčně. Můžete ho mít samostatně, nebo dohromady
          s dalšími dvěma asistenty za 7 500 Kč měsíčně. Jednorázové nastavení 8 až 10 000 Kč.
          Zrušit lze kdykoli, bez výpovědní lhůty.</p>
        <div class="btn-row">
          <a class="btn btn-grad btn-magnet" href="/kontakt">Chci tenhle</a>
          <a class="btn btn-quiet" href="/cenik">Celý ceník</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DALSI ASISTENTI -->
  <section class="sec sec-line" id="dalsi">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow-label">Další asistenti</span>
        <h2 class="h-sec fade-head reveal-words">Tenhle je <span class="grad">jeden ze tří</span></h2>
      </div>
      <div class="cards-2">
        <a class="panel panel-pad panel-glow rev" href="/e-mailove-odpovedi">
          <h3>E-mailové odpovědi</h3>
          <p>Asistent čte poštu, odpovídá na běžné dotazy a co nezná, předá vám. 2 500 Kč měsíčně.</p>
        </a>
        <a class="panel panel-pad panel-glow rev" data-d="1" href="/zpetna-vazba">
          <h3>Zpětná vazba a opakované rezervace</h3>
          <p>Zeptá se po návštěvě, připraví odpověď na recenzi a pozve zákazníka zpátky. 2 500 Kč měsíčně.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec sec-dark sec-line" id="faq">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow-label">Časté dotazy</span>
        <h2 class="h-sec fade-head reveal-words">Na co se ptáte</h2>
      </div>
      <div class="faq">
        <details class="rev"><summary>Kolik stojí AI rezervace a připomínky?</summary><p>4 500 Kč měsíčně, v ceně je 750 rezervací. Samostatně, nebo dohromady s e-mailovými odpověďmi a zpětnou vazbou za 7 500 Kč měsíčně. Jednorázové nastavení 8 až 10 000 Kč. Bez závazku, zrušíte kdykoli.</p></details>
        <details class="rev" data-d="1"><summary>Potřebuji kvůli tomu nový rezervační systém?</summary><p>Ne. Funguje s WhatsAppem, webem nebo Google Kalendářem, které už máte, a umí běžet vedle vašeho stávajícího systému. Když žádný nemáte a jedete papír nebo telefon, nastavíme vám ho celý.</p></details>
        <details class="rev" data-d="2"><summary>Jak to snižuje počet nenastoupených termínů?</summary><p>Připomínkou den předem, na kterou jde odpovědět a rovnou se přeobjednat. Termín se uvolní pro někoho dalšího, místo aby propadl prázdný.</p></details>
        <details class="rev" data-d="3"><summary>Bere rezervace i mimo otevírací dobu?</summary><p>Ano, nepřetržitě. Zákazník se objedná večer i o víkendu, bez telefonu a bez čekání.</p></details>
        <details class="rev" data-d="4"><summary>Jak dlouho trvá nastavení?</summary><p>Do 5 až 7 pracovních dnů od úvodního patnáctiminutového hovoru. Napojení kalendáře, texty i testování řešíme my.</p></details>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap" style="text-align:center">
      <h2 class="h-sec fade-head reveal-words">Kolik vás stojí <span class="grad">prázdná hodina</span>?</h2>
      <p class="lead lead-center rev" data-d="1">Nezávazný hovor na čtvrt hodiny. Dostanete pevnou cenu
        a termín, ne odhad.</p>
      <div class="btn-row rev" data-d="2" style="justify-content:center">
        <a class="btn btn-grad btn-shine" href="/kontakt">Nezávazná nabídka</a>
        <a class="btn btn-quiet" href="/ai-asistenti">Všichni asistenti</a>
      </div>
    </div>
  </section>
</Base>
