---
import Base from '../layouts/Base.astro';
---

<Base title={"Děkujeme! — ALSflow"}
  description={"Váš dotaz byl přijat. Ozveme se do 24 hodin."}
  robots={"noindex, follow"}>

  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <header>
    <a class="logo" href="/">ALS<span>flow</span></a>
  </header>

  <main>
    <div class="thank-card">
      <div class="success-icon">✓</div>
      <h1 class="thank-title">Skvělé!<br><span class="grad">Ozveme se vám.</span></h1>
      <p class="thank-sub">
        Váš dotaz dorazil na <strong>info@alsflow.cz</strong>. Připravíme vám nabídku na míru a ozveme se do <strong>24 hodin</strong>.
      </p>

      <div class="what-next">
        <div class="what-next-title">Co se stane dál</div>
        <ul class="next-steps">
          <li>
            <span class="step-num">1</span>
            <span>Přečteme váš dotaz a připravíme nabídku přesně pro váš byznys</span>
          </li>
          <li>
            <span class="step-num">2</span>
            <span>Do 24 hodin vám zavoláme nebo napíšeme — domluvíme krátký hovor (15 min)</span>
          </li>
          <li>
            <span class="step-num">3</span>
            <span>Po schválení nastavíme vše do 5 pracovních dnů. Vy nic neřešíte.</span>
          </li>
        </ul>
      </div>

      <a class="back-btn" href="/">← Zpět na alsflow.cz</a>
    </div>
  </main>

  <script is:inline>
    /* ── Restore consent & fire GA4 page_view ── */
    (function() {
      const stored = localStorage.getItem('alsflow_consent');
      if (stored === 'granted') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
    })();

    /*
      GOOGLE ADS CONVERSION:
      Once you have your conversion tag from Google Ads, replace the comment
      in the <head> with the actual gtag call, e.g.:

      gtag('event', 'conversion', {
        'send_to': 'AW-XXXXXXXXX/XXXXXXXXXXXXXXXXXXX',
        'value': 1.0,
        'currency': 'CZK'
      });

      This page is your conversion URL — use https://alsflow.cz/dakuji
      as the destination in your Google Ads conversion setup.
    */
  </script>

</Base>

<style is:global>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
      height: 100%;
    }
.orb {
      position: fixed;
      border-radius: 50%;
      pointer-events: none;
      filter: blur(130px);
      z-index: 0;
    }
.orb-1 {
      top: -15%; left: -10%;
      width: 500px; height: 500px;
      background: rgba(34,197,94,0.08);
    }
.orb-2 {
      bottom: -10%; right: -8%;
      width: 600px; height: 600px;
      background: rgba(59,130,246,0.07);
    }
main {
      position: relative;
      z-index: 1;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 1.5rem;
    }
.thank-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border-h);
      border-radius: 28px;
      padding: 3.5rem 3rem;
      text-align: center;
      max-width: 520px;
      width: 100%;
      box-shadow: 0 40px 80px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);
      animation: fadeUp 0.6s ease both;
    }
from { opacity: 0; transform: translateY(24px); }
to   { opacity: 1; transform: translateY(0); }
.success-icon {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: var(--green-s);
      border: 1px solid rgba(34,197,94,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      margin: 0 auto 1.75rem;
      animation: popIn 0.5s 0.15s cubic-bezier(0.34,1.56,0.64,1) both;
    }
from { transform: scale(0.5); opacity: 0; }
to   { transform: scale(1); opacity: 1; }
.thank-title {
      font-size: 2rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.1;
      margin-bottom: 1rem;
      animation: fadeUp 0.5s 0.2s ease both;
    }
.thank-title .grad {
      background: linear-gradient(135deg, #4ade80, #16a34a);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
.thank-sub {
      font-size: 0.95rem;
      color: var(--t2);
      line-height: 1.75;
      max-width: 380px;
      margin: 0 auto 2.25rem;
      animation: fadeUp 0.5s 0.3s ease both;
    }
.what-next {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1.5rem;
      text-align: left;
      margin-bottom: 2rem;
      animation: fadeUp 0.5s 0.4s ease both;
    }
.what-next-title {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--t3);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.85rem;
    }
.next-steps { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; }
.next-steps li {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      font-size: 0.85rem;
      color: var(--t2);
      line-height: 1.5;
    }
.step-num {
      width: 20px; height: 20px;
      border-radius: 50%;
      background: rgba(59,130,246,0.15);
      border: 1px solid rgba(59,130,246,0.3);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.65rem;
      font-weight: 700;
      color: #93c5fd;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }
.back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.75rem;
      border-radius: 12px;
      font-family: var(--font);
      font-size: 0.9rem;
      font-weight: 700;
      text-decoration: none;
      background: transparent;
      color: var(--t1);
      border: 1px solid var(--border-h);
      transition: border-color 0.2s, color 0.2s, transform 0.2s;
      animation: fadeUp 0.5s 0.5s ease both;
    }
.back-btn:hover {
      border-color: rgba(59,130,246,0.4);
      color: #93c5fd;
      transform: translateY(-1px);
    }
.thank-card { padding: 2.5rem 1.5rem; }
.thank-title { font-size: 1.7rem; }
</style>
