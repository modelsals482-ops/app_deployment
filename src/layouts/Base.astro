  <script src="/assets/js/site-pages.js" defer></script>

  <!-- Ozdoby podle výkonnostního stupně. Injektujeme skripty ručně místo
       pevných značek skriptu, protože pevná značka se stáhne vždycky, i když
       by ji skript pak nepoužil. Tady jde právě o to nestáhnout je.
       `defer` se u vloženého skriptu neuplatní, proto async=false, což
       zachová pořadí: Three.js dřív než scenes.js, GSAP dřív než reveal.js. -->
  <script is:inline>
    (function () {
      var stupen = document.documentElement.getAttribute("data-vykon") || "snizeny";
      if (stupen === "minimalni") return;   /* jen obsah, nic dalšího */

      var soubory = [
        "/lenis.min.js",                    /* plynulé rolování, samo se vypne na dotyku */
        "/assets/vendor/gsap.min.js",
        "/assets/vendor/ScrollTrigger.min.js",
        "/assets/js/reveal.js",             /* bez GSAPu jen zviditelní text */
        "/assets/js/flash.js",
      ];

      /* 603 kB Three.js plus scény jen tam, kde to stroj utáhne. */
      if (stupen === "plny") {
        soubory.splice(4, 0, "/assets/vendor/three.r128.min.js", "/assets/js/scenes.js");
      }

      soubory.forEach(function (src) {
        var el = document.createElement("script");
        el.src = src;
        el.async = false;
        document.head.appendChild(el);
      });

      /* ---------------------------------------------------------------
         Hlídač snímků.

         Odhad podle deviceMemory a počtu jader se plete oběma směry:
         hlásí je jen Chromium, zaokrouhluje a nic neví o tom, jak je na
         tom GPU nebo co zrovna běží na pozadí. Tady se proto změří, jak
         se stránka doopravdy hýbe, a když je to špatné, stupeň se sníží
         za běhu. CSS pak scény schová, IntersectionObserver ve scenes.js
         si toho všimne a smyčku zastaví.

         Měří se až po `load`, aby se do toho nepočítalo stahování,
         a jen u plného stupně: níž už není co vypínat.
         --------------------------------------------------------------- */
      if (stupen !== "plny") return;

      window.addEventListener("load", function () {
        var snimky = 0;
        var start = performance.now();

        function tik(t) {
          snimky++;
          if (t - start < 1200) { requestAnimationFrame(tik); return; }

          var fps = (snimky * 1000) / (t - start);
          var novy = fps < 24 ? "minimalni" : fps < 40 ? "snizeny" : null;
          if (!novy) return;

          document.documentElement.setAttribute("data-vykon", novy);
          window.__vykon = novy;
          if (window.__lenis && novy === "minimalni") window.__lenis.destroy();
        }

        /* Dvě otočky navíc, ať se neměří první snímek po nasazení stránky,
           který je pomalý vždycky. */
        requestAnimationFrame(function () {
          requestAnimationFrame(function (t) { start = t; requestAnimationFrame(tik); });
        });
      });
    })();
  </script>
<slot name="tail" />

  <script is:inline>
    /* Předvyplní adresu stránky a prohlížeč, ať to nikdo neopisuje ručně.
       Bez JavaScriptu odkaz pořád funguje, jen s prázdným tělem. */
    (function () {
      var a = document.getElementById("reportBug");
      if (!a) return;
      /* Řádky se skládají přes String.fromCharCode(10), ne přes zpětné lomítko:
         když se tenhle soubor generuje skriptem, escape sekvence se cestou
         snadno spolkne a ze string literálu zbude nedokončený řádek. */
      var NL = String.fromCharCode(10);
      var body = [
        "Co se stalo:", "", "",
        "-- nevyplňujte, pomáhá to při hledání --",
        "Stránka: " + location.href,
        "Prohlížeč: " + navigator.userAgent,
        "Okno: " + window.innerWidth + "x" + window.innerHeight
      ].join(NL);
      a.href = "mailto:info@alsflow.cz?subject=" +
        encodeURIComponent("Chyba na webu: " + location.pathname) +
        "&body=" + encodeURIComponent(body);
    })();
  </script>
  <!-- Klára. V obalu, takže je na každé stránce: umí odpovědět na dotaz
       i navigovat po webu. Načítá se až po zbytku stránky (defer) a bez
       JavaScriptu se nezobrazí vůbec - nic, co by chybělo. -->
  <button class="chat-open" id="chatBubble" type="button" aria-label="Otev&rcaron;&iacute;t chat s Kl&aacute;rou">
    <span class="chat-open__dot" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/></svg>
    <span class="chat-open__label">Zeptejte se Kl&aacute;ry</span>
    <span class="badge" id="chatBadge" aria-hidden="true">&#10022;</span>
  </button>
  <div class="chat-panel" id="chatPanel" role="dialog" aria-label="Chat s Kl&aacute;rou z ALSflow" aria-hidden="true" data-lenis-prevent>
    <div class="chat-head">
      <span class="av">K</span>
      <div><div class="who">Kl&aacute;ra</div><div class="live">odpov&iacute;d&aacute; obvykle do minuty</div></div>
      <span class="chat-count" id="chatCounter">0/20</span>
      <button class="chat-x" id="chatClose" type="button" aria-label="Zav&rcaron;&iacute;t chat">&times;</button>
    </div>
    <div class="chat-messages" id="chatMessages">
      <div class="chat-msg bot"><div class="chat-bubble-msg">Dobr&yacute; den. Zeptejte se na ceny, na to, co d&ecaron;l&aacute;me, nebo &rcaron;ekn&ecaron;te, co hled&aacute;te. Nasm&ecaron;ruju v&aacute;s na spr&aacute;vnou str&aacute;nku.</div></div>
    </div>
    <div class="chat-bar">
      <input id="chatInput" type="text" placeholder="Napi&scaron;te dotaz&hellip;" maxlength="500" autocomplete="off" aria-label="Zpr&aacute;va do chatu" />
      <button id="chatSend" type="button" aria-label="Odeslat">&rarr;</button>
    </div>
  </div>
  <script src="/assets/js/chat-widget.js" defer></script>
</body>
</html>
