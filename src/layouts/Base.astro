---
/**
 * Spolecny obal vsech stranek noveho designu.
 *
 * Hlavicka, paticka, loader a skripty byly do vzniku teto vrstvy zkopirovane
 * v kazdem souboru zvlast: sest kopii navigace, sest paticek, sedm loaderu.
 * Kvuli tomu se rozesly - ctyri stranky mely v rozbalovacim menu polozku
 * Kontakt se slibem "ozvu se tyz den", dve ji nemely vubec. Ted je to na
 * jednom miste a slib odpovida tomu, ktery plati (48 hodin v pracovni dny).
 *
 * Vystup je porad staticke HTML. Do prohlizece nejde zadny JavaScript navic.
 */
export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  current?: string;
  cta?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  current = "",
  cta = "/kontakt",
  robots = "index, follow",
} = Astro.props;

/* aria-current patri jen na aktivni polozku; jinde musi atribut uplne zmizet,
   ne byt prazdny - proto undefined, ktere Astro vynecha. */
const cur = (href: string) => (href === current ? "page" : undefined);
