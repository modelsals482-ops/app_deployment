<style>
  #alsLoader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: #08080c;
    opacity: 1;
    transition: opacity 0.55s ease;
  }

  #alsLoader[hidden] { display: none; }

  html.als-loading,
  html.als-loading body { overflow: hidden; }

  #alsLoader.is-out {
    pointer-events: none;
    opacity: 0;
  }

  /* Modrý podsvit pod značkou, aby plocha nebyla jen černá.
     Řešeno přes ::before, ať se nemusí měnit markup na dvou místech. */
  #alsLoader > div {
    position: relative;
    display: grid;
    place-items: center;
  }

  #alsLoader > div::before {
    position: absolute;
    top: 56%;
    left: 50%;
    z-index: 0;
    width: min(560px, 82vw);
    height: 230px;
    content: "";
    background: radial-gradient(
      ellipse at center,
      rgb(59 130 246 / 30%) 0%,
      rgb(37 99 235 / 14%) 38%,
      transparent 70%
    );
    filter: blur(30px);
    transform: translate(-50%, -50%);
    animation: alsGlow 2.6s ease-in-out infinite;
  }

  /* Značka i linka musí zůstat nad podsvitem. */
  .als-loader__mark,
  .als-loader__bar {
    position: relative;
    z-index: 1;
  }

  @keyframes alsGlow {
    0%, 100% { opacity: 0.72; }
    50%      { opacity: 1; }
  }

  .als-loader__mark {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: clamp(1.9rem, 6vw, 3.1rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
    background: linear-gradient(120deg, #fff 0%, #8b8b9e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    transform: translateY(9px);
    animation: alsRise 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .als-loader__mark span {
    background: linear-gradient(120deg, #60a5fa, #2563eb);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* vlasová linka, která se pod značkou rozjede zleva doprava */
  .als-loader__bar {
    width: clamp(120px, 22vw, 190px);
    height: 1px;
    margin-top: 1.4rem;
    overflow: hidden;
    background: rgb(255 255 255 / 8%);
  }

  .als-loader__bar i {
    display: block;
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, transparent, #3b82f6, transparent);
    animation: alsSweep 1.15s ease-in-out infinite;
  }

  @keyframes alsRise {
    to { opacity: 1; transform: none; }
  }

  @keyframes alsSweep {
    from { transform: translateX(-100%); }
    to   { transform: translateX(350%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .als-loader__mark { opacity: 1; transform: none; animation: none; }
    .als-loader__bar  { display: none; }
    #alsLoader > div::before { animation: none; }
    #alsLoader { transition-duration: 0.001ms; }
  }
</style>

<script is:inline>
  /* =================================================================
     Výkonnostní stupeň. Musí běžet PŘED vším ostatním, protože podle
     něj se rozhoduje, co se vůbec stáhne.

     Web váží 820 kB JavaScriptu a 603 kB z toho je Three.js pro scény
     na pozadí. Na slabém telefonu není problém ani tak vykreslování
     jako rozparsování a zkompilování těch 600 kB, a než je hotové,
     stránka nejde ani rolovat. Proto se na slabém zařízení nestahuje
     vůbec.

     Tři stupně, zapisují se na <html data-vykon>:
       plny       všechno včetně 3D scén
       snizeny    bez Three.js a bez scén, animace textu zůstávají
       minimalni  jen obsah; žádné animace, žádné rozmazané pozadí

     Nikdy se nevypíná obsah, jen ozdoby. Nejhorší stupeň je pořád celý
     web, jen stojí.
     ================================================================= */
  (function () {
    var d = document.documentElement;

    function stupen() {
      try {
        var mm = window.matchMedia;

        /* Uživatel si o klid řekl sám. Nic dalšího neřešíme. */
        if (mm && mm("(prefers-reduced-motion: reduce)").matches) return "minimalni";

        /* Režim úspory dat: 600 kB knihovny na pozadí je přesně to, co
           tím uživatel odmítá. */
        var c = navigator.connection;
        if (c) {
          if (c.saveData) return "minimalni";
          if (/(^|-)2g$/.test(c.effectiveType || "")) return "minimalni";
          if (c.effectiveType === "3g") return "snizeny";
        }

        /* deviceMemory hlásí jen Chromium a zaokrouhluje dolů na 0.25,
           0.5, 1, 2, 4, 8. Dvě GB a míň je slabý telefon. */
        var mem = navigator.deviceMemory;
        if (typeof mem === "number" && mem <= 2) return "minimalni";

        var jader = navigator.hardwareConcurrency;
        if (typeof jader === "number" && jader <= 2) return "minimalni";
        if (typeof mem === "number" && mem <= 4) return "snizeny";
        if (typeof jader === "number" && jader <= 4) return "snizeny";

        /* Bez WebGL by scény stejně nenaběhly, jen by se marně stáhly.
           Kontext hned zahazujeme, ať nedržíme GPU zbytečně. */
        var cv = document.createElement("canvas");
        var gl = cv.getContext("webgl") || cv.getContext("experimental-webgl");
        if (!gl) return "snizeny";
        var ztrata = gl.getExtension("WEBGL_lose_context");
        if (ztrata) ztrata.loseContext();

        return "plny";
      } catch (e) {
        /* Když detekce spadne, radši méně efektů než rozbitá stránka. */
        return "snizeny";
      }
    }

    var s = stupen();

    /* Ruční přepnutí pro testování: ?vykon=minimalni */
    try {
      var vynuceno = new URLSearchParams(location.search).get("vykon");
      if (vynuceno === "plny" || vynuceno === "snizeny" || vynuceno === "minimalni") s = vynuceno;
    } catch (e) {}

    d.setAttribute("data-vykon", s);
    window.__vykon = s;
  })();
</script>

<script is:inline>
  /* Běží co nejdřív, ještě před vykreslením obsahu - jinak by loader
     naskočil až na chvíli hotovou stránku a probliklo by to. */
  (function () {
    try {
      if (sessionStorage.getItem('als-seen')) return;
    } catch (e) {
      /* privátní okno nebo zakázané úložiště - loader prostě ukážeme */
    }
    document.documentElement.classList.add('als-loading');
  })();
</script>
