---
/**
 * Spolecny obal vsech stranek noveho designu.
 *
 * Hlavicka, paticka, loader a skripty byly do vzniku teto vrstvy zkopirovane
 * v kazdem souboru zvlast: sest kopii navigace, sest paticek, sedm loaderu.
 * Kvuli tomu se rozesly - ctyri stranky mely v rozbalovacim menu polozku
 * Kontakt se slibem "ozvu se tyz den", dve ji nemely vubec. Ted je to na
 * jednom miste a slib odpovida tomu, ktery plati (48 hodin v pracovni dny).
 *
 * Vystup je porad staticke HTML. Do prohlizece nejde zadny JavaScript navic.
 */
export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  current?: string;
  cta?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  current = "",
  cta = "/kontakt",
  robots = "index, follow",
} = Astro.props;

/* aria-current patri jen na aktivni polozku; jinde musi atribut uplne zmizet,
   ne byt prazdny - proto undefined, ktere Astro vynecha. */
const cur = (href: string) => (href === current ? "page" : undefined);
---
<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content={robots} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://alsflow.cz/og-image.png" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/site-pages.css" />
  <link rel="stylesheet" href="/assets/css/flash.css" />
  <!-- úvodní loader — jediný zdroj je tenhle obal, samostatný soubor už neexistuje -->
<style>
  #alsLoader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: #08080c;
    opacity: 1;
    transition: opacity 0.55s ease;
  }

  #alsLoader[hidden] { display: none; }

  html.als-loading,
  html.als-loading body { overflow: hidden; }

  #alsLoader.is-out {
    pointer-events: none;
    opacity: 0;
  }

  /* Modrý podsvit pod značkou, aby plocha nebyla jen černá.
     Řešeno přes ::before, ať se nemusí měnit markup na dvou místech. */
  #alsLoader > div {
    position: relative;
    display: grid;
    place-items: center;
  }

  #alsLoader > div::before {
    position: absolute;
    top: 56%;
    left: 50%;
    z-index: 0;
    width: min(560px, 82vw);
    height: 230px;
    content: "";
    background: radial-gradient(
      ellipse at center,
      rgb(59 130 246 / 30%) 0%,
      rgb(37 99 235 / 14%) 38%,
      transparent 70%
    );
    filter: blur(30px);
    transform: translate(-50%, -50%);
    animation: alsGlow 2.6s ease-in-out infinite;
  }

  /* Značka i linka musí zůstat nad podsvitem. */
  .als-loader__mark,
  .als-loader__bar {
    position: relative;
    z-index: 1;
  }

  @keyframes alsGlow {
    0%, 100% { opacity: 0.72; }
    50%      { opacity: 1; }
  }

  .als-loader__mark {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: clamp(1.9rem, 6vw, 3.1rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
    background: linear-gradient(120deg, #fff 0%, #8b8b9e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    transform: translateY(9px);
    animation: alsRise 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .als-loader__mark span {
    background: linear-gradient(120deg, #60a5fa, #2563eb);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* vlasová linka, která se pod značkou rozjede zleva doprava */
  .als-loader__bar {
    width: clamp(120px, 22vw, 190px);
    height: 1px;
    margin-top: 1.4rem;
    overflow: hidden;
    background: rgb(255 255 255 / 8%);
  }

  .als-loader__bar i {
    display: block;
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, transparent, #3b82f6, transparent);
    animation: alsSweep 1.15s ease-in-out infinite;
  }

  @keyframes alsRise {
    to { opacity: 1; transform: none; }
  }

  @keyframes alsSweep {
    from { transform: translateX(-100%); }
    to   { transform: translateX(350%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .als-loader__mark { opacity: 1; transform: none; animation: none; }
    .als-loader__bar  { display: none; }
    #alsLoader > div::before { animation: none; }
    #alsLoader { transition-duration: 0.001ms; }
  }
</style>

<script>
  /* Běží co nejdřív, ještě před vykreslením obsahu — jinak by loader
     naskočil až na chvíli hotovou stránku a probliklo by to. */
  (function () {
    try {
      if (sessionStorage.getItem('als-seen')) return;
    } catch (e) {
      /* privátní okno nebo zakázané úložiště — loader prostě ukážeme */
    }
    document.documentElement.classList.add('als-loading');
  })();
</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={canonical} />
  <slot name="head" />
</head>
<body>
<div id="alsLoader" aria-hidden="true">
  <div>
    <div class="als-loader__mark">ALS<span>flow</span></div>
    <div class="als-loader__bar"><i></i></div>
  </div>
</div>

<noscript>
  <style>#alsLoader { display: none; }</style>
</noscript>

<script>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById('alsLoader');

    /* Značka se v relaci ukazuje jen jednou. Když ji uživatel už viděl,
       skript výše nepřidal třídu — loader hned odstraníme. */
    if (!el || !root.classList.contains('als-loading')) {
      if (el) el.remove();
      return;
    }

    var MIN = 900;    /* ať to neproblikne a značka je chvíli vidět */
    var MAX = 4000;   /* pojistka: po této době mizí vždycky, i kdyby scéna nedojela */
    var start = Date.now();
    var done = false;

    function finish() {
      if (done) return;
      done = true;

      el.classList.add('is-out');
      root.classList.remove('als-loading');

      /* Po doznění se maže z DOM, aby nezavazel fokusu ani čtečce. */
      setTimeout(function () { el.remove(); }, 600);

      try { sessionStorage.setItem('als-seen', '1'); } catch (e) {}
    }

    /* Loader nemá mizet po pevně daném čase, ale až když je opravdu na co se
       dívat. Jinak návštěvník chytí přesně to, čemu se loader má vyhnout:
       první vteřinu, kdy se kompilují shadery a scéna běží na pár snímcích.

       Čeká se na tři věci a bere se ta poslední z nich:
         1. window.load  — dojely i vendorované knihovny (Three, GSAP)
         2. fonts.ready  — text se hned po odkrytí nepřepíše jiným řezem
         3. dva po sobě jdoucí snímky pod 50 ms — hlavní vlákno už není
            ucpané, takže animace poběží plynule

       Ta třetí podmínka je tu schválně místo signálu ze scenes.js: nemusí
       o ní žádná scéna vědět, měří se rovnou to, co návštěvník uvidí.

       MAX je nepřekročitelný. Čekat na dokonalost na pomalé lince znamená
       koukat na loader deset vteřin a odejít — to je horší než trhaná
       animace. Stránka je bez scény použitelná, odhalování textu selhává
       otevřeně, takže se nic neztratí. */
    function smoothFrames(cb) {
      if (!window.requestAnimationFrame) return cb();
      var last = 0, good = 0;
      (function tick(now) {
        if (last && now - last < 50) good++; else good = 0;
        last = now;
        if (good >= 2 || done) cb();
        else requestAnimationFrame(tick);
      })(0);
    }

    function ready() {
      var waited = 0, need = 2;
      function step() {
        if (++waited < need) return;
        smoothFrames(function () {
          setTimeout(finish, Math.max(0, MIN - (Date.now() - start)));
        });
      }

      if (document.fonts && document.fonts.ready) document.fonts.ready.then(step, step);
      else step();

      step();   /* window.load už proběhl, tohle je jeho hlas */
    }

    if (document.readyState === 'complete') ready();
    else window.addEventListener('load', ready);

    setTimeout(finish, MAX);
  })();
</script>

  
